---
import portrait from '../../assets/gallery/ilir-tafa/IlirTafa-1.jpg';
import cast from '../../assets/gallery/ilir-tafa/Kasta e aktorëve të filmit ZABA Sarajevo Film Festival.jpg';
import interview from '../../assets/gallery/ilir-tafa/terorista-interview-4.jpg';
import stage from '../../assets/gallery/sonte-jam-vetem/5.jpg';
import press from '../../assets/gallery/ilir-tafa/konferenca-per-media.jpg';
import { localeFromPath, localizedUrl } from '../../i18n';
const locale=localeFromPath(Astro.url.pathname);
const copy={sq:{title:'Galeria',cta:'SHIKO MË SHUMË'},en:{title:'Gallery',cta:'VIEW MORE'},bs:{title:'Galerija',cta:'POGLEDAJ VIŠE'}}[locale];
const images=[portrait,cast,interview,stage,press];
---

<section class="gallery-home">
  <div class="gallery-home__inner">
    <h2>{copy.title}</h2>
    <div class="gallery-home__grid">
      {images.map((image,i)=><figure class:list={['gallery-home__item',`item-${i+1}`]}><img src={image.src} alt="" loading="lazy" /></figure>)}
    </div>
    <a href={localizedUrl(locale,'gallery')} class="btn-gold">{copy.cta}</a>
  </div>
</section>

<style>
  .gallery-home { padding:0 var(--page-gutter) clamp(5.5rem,8vw,8rem); background:#070b10; }
  .gallery-home__inner { width:min(100%,1280px); margin:auto; padding-top:clamp(3.5rem,5vw,5rem); border-top:1px solid rgba(198,166,100,.7); text-align:center; }
  .gallery-home h2 { text-align:left; color:var(--color-gold-bright); font-size:var(--home-section-title-size); line-height:1; font-weight:400; margin-bottom:2.25rem; }
  .gallery-home__grid { height:500px; display:grid; grid-template-columns:1.15fr 1.35fr 1.35fr; grid-template-rows:1fr 1fr; gap:1.15rem; }
  .gallery-home__item { overflow:hidden; background:#111820; }
  .gallery-home__item img { width:100%;height:100%;object-fit:cover;transition:transform .55s var(--ease),filter .4s; }
  .gallery-home__item:hover img { transform:scale(1.035); filter:brightness(1.08); }
  .item-1 { grid-row:span 2; }.item-5{grid-column:3}.gallery-home .btn-gold{min-width:190px;margin-top:2.5rem}
  @media(max-width:900px) {
    .gallery-home h2 { font-size:2.8rem; }
    .gallery-home__grid { height:390px; gap:.85rem; }
    .gallery-home__item {
      position:relative;
      border:1px solid rgba(212,177,106,.55);
      border-radius:.55rem;
      box-shadow:0 8px 24px rgba(0,0,0,.28), inset 0 0 14px rgba(212,177,106,.04);
    }
    .gallery-home__item::after {
      content:'';
      position:absolute;
      inset:0;
      border-radius:inherit;
      background:linear-gradient(180deg,transparent 65%,rgba(7,11,16,.22));
      pointer-events:none;
    }
  }
  @media(max-width:700px){.gallery-home__grid{height:auto;grid-template-columns:1fr 1fr;grid-template-rows:repeat(3,180px)}.item-1{grid-row:span 2}.item-5{grid-column:auto}.gallery-home h2{text-align:center}}
  @media(max-width:390px) {
    .gallery-home__inner { padding-top:2.5rem; }
    .gallery-home h2 { margin-bottom:1.5rem; font-size:2.7rem; }
    .gallery-home__grid {
      width:min(100%,320px);
      margin-inline:auto;
      grid-template-columns:1fr 1fr;
      grid-template-rows:180px 115px 115px;
      gap:.65rem;
    }
    .gallery-home__item { border-radius:.5rem; }
    .item-1 { grid-column:1 / -1; grid-row:auto; }
    .item-5 { grid-column:auto; }
  }
</style>
