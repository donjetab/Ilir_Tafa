---
import aboutImg from '../../assets/portrait.jpg';
import { localeFromPath, localizedUrl } from '../../i18n';

const locale = localeFromPath(Astro.url.pathname);
const copy = {
  sq: {
    title: 'Për Ilir Tafën', cta: 'BIOGRAFIA',
    text: 'Ilir Tafa (i lindur më 1974 në Lipjan) është një nga aktorët më të njohur kosovarë, i afirmuar si në Kosovë ashtu edhe në rajon, sidomos në Bosnjë e Kroaci. Ai ka interpretuar në filma, seriale dhe shfaqje teatrore, ndër të cilat veçohen Sonte jam vetëm, Alo 038, Atje ku nuk lind dielli, Shtëpia e tmerrit dhe seriali boshnjak Lud, Zbunjen, Normalan.',
    backgroundText: 'Ilir Tafa (i lindur më 1974 në Lipjan) është një nga aktorët më të njohur kosovarë, i afirmuar si në Kosovë ashtu edhe në rajon, sidomos në Bosnje e Kroaci. Ai ka interpretuar në filma, seriale dhe shfaqje teatrore, ndër të cilat veçohen Sonte jam vetëm, Alo 038, Atje ku nuk lind dielli, Shtëpia e tmerrit dhe seriali boshnjak Lud, Zbunjen, Normalan, që i dha famë të gjerë rajonale. Për talentin e tij, Ilir Tafa është vlerësuar me disa çmime të rëndësishme, përfshirë titullin “Aktori më i Mirë” në Festivalin e Filmit në Gjilan, Festivalin e Komedisë Shqiptare në Preshevë, Festivalin Ballkanik të Teatrit në Prishtinë dhe Festivalin e Teatrove Shqiptare në Dibër të Maqedonisë. Përveç karrierës artistike, ai mban gradën më të lartë universitare në aktrim dhe vepron si pedagog në Prishtinë.'
  },
  en: {
    title: 'About Ilir Tafa', cta: 'BIOGRAPHY',
    text: 'Ilir Tafa (born in 1974 in Lipjan) is one of Kosovo’s best-known actors, established both at home and across the region, especially in Bosnia and Croatia. His work spans film, television, and theatre, including Sonte jam vetëm, Alo 038, Atje ku nuk lind dielli, Shtëpia e tmerrit, and the Bosnian series Lud, Zbunjen, Normalan.'
  },
  bs: {
    title: 'O Iliru Tafi', cta: 'BIOGRAFIJA',
    text: 'Ilir Tafa (rođen 1974. u Lipljanu) jedan je od najpoznatijih kosovskih glumaca, afirmisan na Kosovu i širom regiona, posebno u Bosni i Hrvatskoj. Igrao je u filmovima, televizijskim serijama i pozorišnim predstavama, među kojima su Sonte jam vetëm, Alo 038, Atje ku nuk lind dielli, Shtëpia e tmerrit i bosanskohercegovačka serija Lud, zbunjen, normalan.'
  },
}[locale];
---

<section class="about-home">
  <div class="about-home__inner">
    <div class="about-home__portrait reveal">
      <div class="about-home__script" aria-hidden="true">
        <p>{'backgroundText' in copy ? copy.backgroundText : copy.text}</p>
      </div>
      <img src={aboutImg.src} alt="Portret i Ilir Tafës" loading="lazy" />
    </div>
    <div class="about-home__copy reveal-near">
      <h2>{copy.title}</h2>
      <p>{copy.text}</p>
      <a href={localizedUrl(locale, 'about')} class="btn-gold">{copy.cta}</a>
    </div>
  </div>
</section>

<style>
  .about-home { position:relative; z-index:2; min-height:90svh; margin-top:clamp(-220px, -14vw, -160px); padding:clamp(4.5rem, 7vw, 7rem) var(--page-gutter); background:transparent; display:flex; align-items:flex-start; }
  .about-home__inner { width:min(100%, 1280px); margin:auto; display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:clamp(3rem, 4.5vw, 5rem); align-items:center; }
  .about-home__portrait { position:relative; left:clamp(-2.5rem, -2.2vw, -1.5rem); justify-self:center; width:min(100%, 400px); }
  .about-home__portrait::before { content:''; position:absolute; inset:-1px; border:1px solid rgba(212,177,106,.75); border-radius:.7rem; z-index:2; pointer-events:none; }
  .about-home__portrait img { position:relative; z-index:1; display:block; width:100%; aspect-ratio:1/1.08; object-fit:cover; filter:saturate(0); border-radius:.7rem; }
  .about-home__script {
    position:absolute;
    z-index:0;
    top:0%;
    left:48%;
    width:min(58vw, 650px);
    transform:translateX(-50%) rotate(-8deg);
    color:rgba(198,166,100,.09);
    font-family:'Cormorant Garamond', serif;
    font-size:clamp(1rem, 1.25vw, 1.35rem);
    font-weight:400;
    font-style:italic;
    line-height:1.9;
    pointer-events:none;
    overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 18%,#000 76%,transparent 100%);
    mask-image:linear-gradient(90deg,transparent 0%,#000 18%,#000 76%,transparent 100%);
  }
  .about-home__script p { margin:0; font:inherit; }
  .about-home__copy { position:relative; z-index:2; width:min(calc(100% + clamp(4rem, 7vw, 8rem)), 760px); }
  .about-home__copy h2 { font-size:var(--home-section-title-size); font-weight:400; margin-bottom:1.4rem; }
  .about-home__copy p { max-width:none; color:rgba(255,255,255,.76); font-size:.96rem; line-height:1.8; }
  .about-home__copy .btn-gold { margin-top:1.8rem; }
  @media (min-width:1024px) and (max-width:1440px) {
    .about-home__inner {
      grid-template-columns:minmax(0, .95fr) minmax(0, 1.05fr);
      gap:clamp(2.5rem, 4vw, 4rem);
    }
    .about-home__copy {
      box-sizing:border-box;
      width:100%;
      padding-right:clamp(2rem, 5vw, 4.5rem);
    }
  }
  @media (min-width: 761px) and (max-width: 900px) {
    .about-home__inner { gap:2.25rem; }
    .about-home__portrait { left:0; width:min(100%, 285px); }
    .about-home__copy { width:100%; }
    .about-home__copy h2 { margin-bottom:1rem; font-size:2.8rem; }
    .about-home__copy p { font-size:.82rem; line-height:1.65; }
    .about-home__copy .btn-gold { margin-top:1.25rem; padding:.6rem 1.25rem; font-size:.75rem; }
  }
  @media (max-width: 760px) {
    .about-home { min-height:auto; margin-top:-100px; padding-top:3rem; }
    .about-home__inner { grid-template-columns:1fr; gap:2.6rem; }
    .about-home__portrait { left:0; width:min(76vw, 360px); }
    .about-home__script { display:none; }
    .about-home__copy { width:100%; text-align:center; }
    .about-home__copy p { text-align:left; }

    .about-home__copy { padding-inline:1rem; }
    .about-home__script {
      display: block;
      top: 11%;
      left: 50%;
      width: min(92vw, 515px);
      font-size: 1rem;
      line-height: 1.8;
    }
    @media (max-width: 500px) {
      .about-home__portrait{
        width: min(88vw, 300px);
      }
          .about-home__script {
      display: block;
      top: 4%;
      left: 50%;
      width: min(92vw, 600px);
      font-size: 1rem;
      line-height: 1.8;
    }
    @media (max-width:430px) {
      .about-home__inner { gap:2rem; }
      .about-home__portrait { width:min(70vw,250px); }
      .about-home__copy { padding-inline:.75rem; }
      .about-home__copy h2 { margin-bottom:1rem; font-size:2.5rem; }
      .about-home__copy p { font-size:.78rem; line-height:1.65; }
      .about-home__copy .btn-gold { margin-top:1.25rem; padding:.55rem 1.15rem; font-size:.7rem; }
    }
  }
</style>
