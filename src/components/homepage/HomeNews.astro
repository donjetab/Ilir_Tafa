---
import { localeFromPath, localizedUrl } from '../../i18n';
const entries=import.meta.glob('../../content/news/*.json',{eager:true,import:'default'});
const locale=localeFromPath(Astro.url.pathname);
const copy={sq:{title:'Lajmet e fundit',read:'LEXO MË SHUMË',all:'LEXO MË SHUMË'},en:{title:'Latest news',read:'READ MORE',all:'VIEW ALL NEWS'},bs:{title:'Najnovije vijesti',read:'PROČITAJ VIŠE',all:'SVE VIJESTI'}}[locale];
type Post={type?:'internal'|'external';slug:string;date?:string;cover?:string;title?:string;excerpt?:string;sourceUrl?:string};
const posts: Post[] = Object.entries(entries).map(([file,value]) => {
  const p = value as Partial<Post>;
  return {
    ...p,
    slug: p.slug ?? file.split('/').pop()!.replace('.json',''),
  } as Post;
});
const wanted=new Set(['bretkosat-teatri-prizren','abasadori-kulturor-i-evropes']);
const selected=posts.filter((post)=>wanted.has(post.slug));
const items=(selected.length>=2?selected:posts.filter((post)=>post.cover)).slice(0,2);
const href=(post:Post)=>post.sourceUrl||localizedUrl(locale,`news/${post.slug}`);
---

<section class="news-home">
  <div class="news-home__inner">
    <h2>{copy.title}</h2>
    <div class="news-home__grid">
      {items.map((post)=><article class="news-home__card">
        <a href={href(post)} target={post.type==='external'?'_blank':undefined} rel={post.type==='external'?'noopener noreferrer':undefined} class:list={['news-home__image', post.slug==='abasadori-kulturor-i-evropes' && 'news-home__image--top']}>
          {post.cover&&<img src={post.cover} alt={post.title??''} loading="lazy" />}
        </a>
        <div class="news-home__copy">
          {post.date&&<time datetime={post.date}>{new Date(post.date).toLocaleDateString(locale==='sq'?'sq-AL':locale==='bs'?'bs-BA':'en-US')}</time>}
          <h3><a href={href(post)}>{post.title}</a></h3>
          {post.excerpt&&<p>{post.excerpt}</p>}
          <a class="news-home__read" href={href(post)}>{copy.read} →</a>
        </div>
      </article>)}
    </div>
    <a href={localizedUrl(locale,'news')} class="btn-gold">{copy.all}</a>
  </div>
</section>

<style>
  .news-home{padding:0 var(--page-gutter) clamp(5rem,9vw,9rem);background:#070b10}
  .news-home__inner{width:min(100%,var(--content-width));margin:auto;padding-top:clamp(3rem,6vw,6rem);border-top:1px solid rgba(198,166,100,.65);text-align:center}.news-home h2{text-align:left;font-size:clamp(3.1rem,5.5vw,5.4rem);font-weight:400;margin-bottom:2rem}.news-home__grid{display:grid;grid-template-columns:1fr 1fr;gap:2.4rem}.news-home__card{min-height:235px;display:grid;grid-template-columns:38% 1fr;gap:1.2rem;padding:.65rem;border:1px solid rgba(212,177,106,.7);border-radius:1rem;text-align:left;background:rgba(255,255,255,.012)}.news-home__image{display:block;overflow:hidden;border-radius:.7rem;background:#111820}.news-home__image img{width:100%;height:100%;object-fit:cover}.news-home__copy{padding:.55rem .7rem .4rem 0;display:flex;flex-direction:column}.news-home time{color:var(--color-gold-bright);font-size:.66rem}.news-home h3{margin:.6rem 0;font:500 1rem/1.35 Poppins,sans-serif}.news-home__copy p{color:rgba(255,255,255,.68);font-size:.72rem;line-height:1.65;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.news-home__read{margin-top:auto;color:var(--color-gold-bright);font-size:.66rem}.news-home .btn-gold{margin-top:2.8rem}@media(max-width:850px){.news-home__grid{grid-template-columns:1fr}.news-home h2{text-align:center}}@media(max-width:520px){.news-home__card{grid-template-columns:1fr}.news-home__image{height:190px}.news-home__copy{padding:.5rem}}
  .news-home h2 { font-size:var(--home-section-title-size); text-align:center; }
  .news-home__inner { width:min(100%,1280px); }
  .news-home__image--top img { object-position:center 20%; }
  @media(min-width:521px) and (max-width:850px) {
    .news-home__card { height:235px; min-height:0; }
    .news-home__image { height:100%; }
  }
  @media(max-width:500px) {
    .news-home__grid { width:min(100%,360px); margin-inline:auto; gap:1.25rem; }
    .news-home__card { min-height:0; padding:.5rem; }
    .news-home__image { height:145px; }
    .news-home__copy { padding:.4rem .35rem .25rem; }
    .news-home h3 { margin:.45rem 0; font-size:.9rem; }
    .news-home__copy p { font-size:.66rem; line-height:1.5; -webkit-line-clamp:3; }
  }
  @media(max-width:430px) {
    .news-home h2 { font-size:2.45rem; white-space:nowrap; }
  }
</style>
