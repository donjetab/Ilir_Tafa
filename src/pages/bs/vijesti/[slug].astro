---
import Page from '../../news/[slug].astro';
type Post = { type?: 'internal' | 'external'; slug?: string; title:string };
export function getStaticPaths() {
  const posts = import.meta.glob('../../../content/news/*.json', { eager:true, import:'default' });
  return Object.entries(posts).flatMap(([file,value]) => {
    const post=value as Post;
    if(post.type !== 'internal') return [];
    return [{ params:{ slug:post.slug ?? file.split('/').pop()!.replace('.json','') }, props:{post} }];
  });
}
---
<Page {...Astro.props} />
