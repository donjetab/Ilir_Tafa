---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EpisodesGrid from "../components/works/EpisodesGrid.astro";
import { localeFromPath, localizedUrl } from '../i18n';

type WorksData = CollectionEntry<'works'>['data'];
const {
  title, description, year, type, role, poster, director, venue, episodes, films
} = Astro.props as WorksData;

const eps = Array.isArray(episodes) ? episodes : [];
const isFilm = type === "film";

---

<html lang={localeFromPath(Astro.url.pathname)}>
  <head>


    <BaseHead title={title + " | Ilir Tafa"} description={description ?? `${title} — ${type} (${year})`} image={poster} />
    <style>
      body { background:#0b1116; margin:0; }
      main { width:1100px; max-width:calc(100% - 2rem); margin:0 auto; padding:2.5rem 0 5rem; }
      .hero { display:grid; grid-template-columns: 360px 1fr; gap:1.5rem; }
      @media (max-width:900px){ .hero { grid-template-columns:1fr; } }
      .poster { width:100%; aspect-ratio:2/3; object-fit:cover; border-radius:14px; border:1px solid rgba(255,255,255,.08); background:#111821; }
      .title { margin:.25rem 0 0; color:#e7ecef; font-size:2.2rem; line-height:1.15; }
      .row { display:flex; gap:.5rem; margin-top:1rem !important; margin-bottom:1rem; flex-wrap:wrap; }
      .badge { font-size:.78rem; padding:.28rem .6rem; border:1px solid rgba(255,255,255,.14); border-radius:999px; color:#c9c9c9; text-transform:uppercase; }
      .body { margin-top:2rem; color:#d6dde3; line-height:1.65; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <p style="margin-bottom:1.5rem;">
        <a href={localizedUrl(localeFromPath(Astro.url.pathname), 'works')} style="color:#9aa4ad;text-decoration:none;">← Kthehu te Veprat</a>
      </p>

      <section class="hero">
        {poster ? <Image class="poster" src={poster} alt={title} width={720} height={1080} /> : <div class="poster"></div>}
        <div>
          <h1 class="title">{title}</h1>
          <div class="row">
            <span class="badge">{type}</span>
            {year && <span class="badge">{year}</span>}
            {typeof films === "number" && films > 0 && (
              <span class="badge">Film: {films}</span>
            )}
            {Array.isArray(episodes) && episodes.length > 0 && (
              <span class="badge">
                {type === "film" ? `${episodes.length} pjesë` : `${episodes.length} episode`}
              </span>
            )}
          </div>



          {role && <p style="color:#cdd5db;margin:.25rem 0 1rem;">Roli: {role}</p>}
          {director && <p style="color:#cdd5db;margin:.25rem 0 1rem;">Regjia: {director}</p>}
          {venue && type === 'theatre' && <p style="color:#cdd5db;margin:.25rem 0 1rem;">Vendi: {venue}</p>}

          <div class="body">
            <slot />
          </div>
        </div>
      </section>

      <!-- placeholder only; content comes from [slug].astro -->
      <slot name="afterContent" />

      {eps.length > 0 && (
        <section class="section-gap">
          <EpisodesGrid
            episodes={eps}
            perPage={24}
            label={isFilm ? "Pjesët e filmit" : "Episodet"}
          />

        </section>
      )}
    </main>
    <Footer />
  </body>
</html>

<style>

@media (max-width:900px){
  .poster { 
    width: 60% !important;  
    max-width: 100%;
    aspect-ratio: 2/3;
    margin: 0 auto;  
  }
}
@media (max-width:900px){
  .poster { 
      width: 80% !important;  
    }
}

</style>
