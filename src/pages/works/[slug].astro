---
import { getCollection, render, type CollectionEntry } from "astro:content";
import WorkPost from "../../layouts/WorkPost.astro";
import GallerySwiper from "../../components/works/GallerySwiper.astro";
import type { ImageMetadata } from "astro";

// helper first
function youTubeId(u?: string) {
  if (!u) return null;
  try {
    const url = new URL(u);
    if (url.hostname.includes("youtu.be")) return url.pathname.slice(1);
    if (url.hostname.includes("youtube.com")) return url.searchParams.get("v");
  } catch { return null; }
  return null;
}

export async function getStaticPaths() {
  const works = await getCollection("works");
  return works.map((w) => ({ params: { slug: w.data.slug ?? w.id }, props: w }));
}

type Props = CollectionEntry<'works'>;
const work = Astro.props as Props;
const { Content } = await render(work);

// counts and trailer
const filmCount = typeof work.data.films === "number" ? work.data.films : null;
const episodeCount = Array.isArray(work.data.episodes) ? work.data.episodes.length : 0;
const ytId = youTubeId(work.data.trailer);
const trailerSrc = work.data.trailer ?? null;
const isFileTrailer = !!trailerSrc && !ytId; // local or non-YouTube URL


// gallery
const galleries = await getCollection("gallery");
const imgMap = import.meta.glob("../../assets/gallery/**/*.{jpg,jpeg,png,webp}", {
  eager: true, import: "default",
}) as Record<string, ImageMetadata>;

function resolveImage(folder: string | undefined, file: string) {
  const a = folder ? Object.entries(imgMap).find(([p]) => p.endsWith(`/${folder}/${file}`)) : null;
  return (a?.[1]) ?? Object.entries(imgMap).find(([p]) => p.endsWith("/"+file))?.[1] ?? null;
}

const g = galleries.find((x) => x.data.workSlug === (work.data.slug ?? work.id));
const galleryItems = g ? g.data.photos.map(p => {
  const src = resolveImage(g.data.workSlug, p.image);
  return src && { src, alt: p.alt, caption: p.caption };
}).filter(Boolean) : [];


const hasCounts =
  (typeof filmCount === "number" && filmCount > 0) ||
  (typeof episodeCount === "number" && episodeCount > 0);

---
<WorkPost {...work.data}>
  <Content />

  <div slot="afterContent">
    {hasCounts && (
        <div style="margin:1rem 0 1.25rem; display:flex; gap:.75rem; flex-wrap:wrap">
          {typeof filmCount === "number" && filmCount > 0 && (
            <span style="border:1px solid rgba(255,255,255,.15); padding:.35rem .6rem; border-radius:999px; font-size:.85rem; color:#cfd8e3">
              Film: {filmCount}
            </span>
          )}
          {filmCount == null && episodeCount > 0 && (
            <span style="border:1px solid rgba(255,255,255,.15); padding:.35rem .6rem; border-radius:999px; font-size:.85rem; color:#cfd8e3">
              {work.data.type === "film" ? `${episodeCount} pjesë` : `${episodeCount} episode`}
            </span>
          )}
        </div>
      )}


    {galleryItems.length > 0 && <GallerySwiper items={galleryItems} />}

    {ytId
      ? (
        <div style="margin: 6rem 0 2rem">
          <div style="position:relative; width:100%; max-width:1100px; aspect-ratio:16/9; border-radius:16px; overflow:hidden; border:1px solid rgba(255,255,255,.08); box-shadow:0 12px 28px rgba(0,0,0,.35);">
            <iframe
              src={`https://www.youtube.com/embed/${ytId}`}
              title="Trailer"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              style="position:absolute; inset:0; width:100%; height:100%; border:0;"
              loading="lazy"
            />
          </div>
        </div>
      )
      : (isFileTrailer && trailerSrc) ? (
        <div style="margin: 6rem 0 2rem;">
          <video
              src={trailerSrc}
              autoplay
              muted
              loop
              playsinline
              controls
              preload="metadata"
              style="width:100%; max-width:1100px; aspect-ratio:16/9; background:#111821; border-radius:16px; border:1px solid rgba(255,255,255,.08); box-shadow:0 12px 28px rgba(0,0,0,.35);"
            />

    </div>
  ) : null}

<!-- 
    {isFileTrailer && (
      <div style="margin:1.25rem 0 2rem;">
        <video
          src={trailerSrc}
          controls
          preload="metadata"
          style="width:100%; max-width:1100px; aspect-ratio:16/9; background:#111821; border-radius:16px; border:1px solid rgba(255,255,255,.08); box-shadow:0 12px 28px rgba(0,0,0,.35);"
        />
      </div>
    )} -->

  </div>
</WorkPost>

