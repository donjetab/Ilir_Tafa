---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import NewsCard from "../../components/NewsCard.astro";

const entries = await import.meta.glob("../../content/news/*.json", { eager: true, import: "default" });
const items = Object.values(entries)
  .map((it:any)=>it)
  .sort((a,b)=>String(b.date||"").localeCompare(String(a.date||"")));
---
<html lang="sq">
  <head><BaseHead title="Lajme | Ilir Tafa" description="Lajmet e fundit nga Ilir Tafa." /></head>
  <body class="bg-[#0b1116] text-white">
    <Header />
    <main class="mx-auto px-4 md:px-6 py-10 space-y-6" style="margin-top: 3%;">
      <!-- Top bar -->
    <div class="mx-auto max-w-[100%] px-6 py-16 text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight" style="font-size: 45px;">Lajme</h1>

        <div class="flex justify-center mb-12" style="margin-top: 1.5%;">
      <label class="relative w-full max-w-xl">
        <span class="pointer-events-none absolute left-25 top-3 -translate-y-1/2 text-white/50 text-xl">⌕</span>

        <input
          id="news-search"
          type="search"
          placeholder="Kërko lajme…"
          class="w-[70%] rounded-2xl bg-[#0f141a] pl !border-2 !border-white/30 px-5 py-4 text-lg outline-none focus:!border-white transition"
        />
      </label>
    </div>
    </div>


      <!-- Grid -->
      <main class="mx-auto max-w-[100%] px-4 md:px-6 py-10 space-y-6" style="margin: 4% 10% 10% 10%;">
        <!-- Top bar unchanged -->
        <section id="news-grid" class="grid gap-15 md:grid-cols-2 w-[95%] mx-auto justify-center">

          {items.map((it:any)=>
            <div
              class="news-item w-full max-w-[700px]"
              data-title={(it.title||"").toLowerCase()}
              data-src={(it.sourceName||"").toLowerCase()}
            >
              <NewsCard item={it} />
            </div>
          )}
        </section>

      </main>

    </main>
    <Footer />

    <!-- Tiny client filter -->
    <script>
      const q = document.querySelector('#news-search');
      const items = Array.from(document.querySelectorAll('#news-grid .news-item'));
      q?.addEventListener('input', () => {
        const term = (q as HTMLInputElement).value.trim().toLowerCase();
        for (const el of items) {
          const hay = ((el as HTMLElement).dataset.title + ' ' + (el as HTMLElement).dataset.src).trim();
          (el as HTMLElement).style.display = hay.includes(term) ? '' : 'none';
        }
      });
    </script>
  </body>
</html>

<style>
  #news-search {
  border: 2px solid rgba(255,255,255,0.3) !important;
  border-radius: 1.5rem !important;
}
#news-search:focus {
  border-color: white !important;
}

.pl{
  padding-left: 2.5rem !important;
}
</style>