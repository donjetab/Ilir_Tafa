---
import type { ImageMetadata } from "astro";
interface Item { src: ImageMetadata; alt?: string; caption?: string; }
const { items = [] as Item[] } = Astro.props;
---
{items.length > 0 && (
  <section class="work-gallery" data-gallery>
    <h2 class="gallery_title">Galeria</h2>

    <div class="gallery-shell relative">
      <div class="gallery-stage relative">
        <button data-role="prev" type="button" class="absolute left-2 top-1/2 -translate-y-1/2 z-10 rounded-full bg-black/60 p-2 text-white lightboxButton">❮</button>
        <button data-role="next" type="button" class="absolute right-2 top-1/2 -translate-y-1/2 z-10 rounded-full bg-black/60 p-2 text-white lightboxButton">❯</button>

        <div class="g-track flex overflow-x-auto scroll-smooth gap-4" style="scroll-snap-type:x mandatory;">
        {items.map((it: Item, i: number) => (
          <figure
            class="g-card snap-start shrink-0 rounded-xl overflow-hidden bg-[#111821] border border-white/10 cursor-pointer"

            data-index={i}
            data-fullsrc={it.src.src}
            data-alt={it.alt ?? ""}
            data-caption={it.caption ?? ""}>
            <img src={it.src.src} width={it.src.width} height={it.src.height} alt={it.alt ?? ""} loading="lazy" draggable="false" class="w-full h-full object-cover block" />
            {it.caption && <figcaption class="px-3 py-2 text-sm text-white/80">{it.caption}</figcaption>}
          </figure>
        ))}
        </div>
      </div>
      <div class="g-pagination" aria-label="Faqet e galerisë"></div>
    </div>

    <!-- Lightbox -->
    <div class="g-modal fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 p-4">
      <button data-role="close" class="absolute top-4 right-4 text-white text-2xl lightboxButton" aria-label="Mbyll">✕</button>
      <button data-role="mprev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white lightboxButton">❮</button>
      <button data-role="mnext" class="absolute right-4 top-1/2 -translate-y-1/2 text-white lightboxButton">❯</button>
      <figure class="max-w-5xl w-full">
        <img class="g-image w-full h-auto rounded-xl border border-white/20" alt="" draggable="false" />
        <figcaption class="g-caption mt-3 text-center text-white/90"></figcaption>
        <p class="g-counter" aria-live="polite"></p>
      </figure>
    </div>
  </section>
)}


<script is:inline>
  (() => {
    const root  = document.querySelector('section[data-gallery]');
    if (!root) return;

    // ---- Elements
    const track = root.querySelector('.g-track');
    const cards = Array.from(root.querySelectorAll('.g-card'));
    const modal = root.querySelector('.g-modal');
    const imgEl = modal.querySelector('.g-image');
    const capEl = modal.querySelector('.g-caption');
    const counterEl = modal.querySelector('.g-counter');
    const btnClose = modal.querySelector('[data-role="close"]');
    const btnPrev  = modal.querySelector('[data-role="mprev"]');
    const btnNext  = modal.querySelector('[data-role="mnext"]');

    // ---- State
    let index = 0;

    // ---- Render
    function render(i){
      const card = cards[i];
      if (!card) return;
      imgEl.src = card.dataset.fullsrc || card.querySelector('img')?.src || '';
      imgEl.alt = card.dataset.alt || '';
      capEl.textContent = card.dataset.caption || '';
      counterEl.textContent = `${i + 1} / ${cards.length}`;
    }

    // ---- Open/close
    function openAt(i){
      index = (i + cards.length) % cards.length;
      render(index);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('gallery-lightbox-open');
      document.documentElement.style.overflow = 'hidden';
    }
    function close(){
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('gallery-lightbox-open');
      document.documentElement.style.overflow = '';
    }

    function next(){ index = (index + 1) % cards.length; render(index); }
    function prev(){ index = (index - 1 + cards.length) % cards.length; render(index); }

    // ---- Public hook for your pointer code
    window.__openLightbox = (startTarget) => {
      const fig = startTarget?.closest?.('.g-card');
      if (!fig) return;
      const i = cards.indexOf(fig);
      if (i >= 0) openAt(i);
    };

    // ---- Click fallback (desktop/mouse)
    cards.forEach((c, i) => {
      c.addEventListener('click', () => {
        // ignore if drag occurred (pointer code sets moved)
        if (typeof window.__g_dragging === 'boolean' && window.__g_dragging) return;
        openAt(i);
      });
    });

    // ---- Track drag for desktop
    if (track) {
      let down=false, sx=0, sl=0, moved=false, startTarget=null;
      const pagination = root.querySelector('.g-pagination');
      let pageCount = 1;
      function cardW(){ const c = track.querySelector('.g-card'); return c ? c.getBoundingClientRect().width + 16 : 320; }
      function cardsPerView(){ return Math.max(1, Math.round(track.clientWidth / cardW())); }
      function currentPage(){ return Math.max(0, Math.min(pageCount - 1, Math.round(track.scrollLeft / (cardW() * cardsPerView())))); }
      function updateDots(){ pagination?.querySelectorAll('button').forEach((dot, i) => dot.classList.toggle('is-active', i === currentPage())); }
      function buildDots(){
        if (!pagination) return;
        pageCount = Math.max(1, Math.ceil(cards.length / cardsPerView()));
        pagination.innerHTML = '';
        for (let i = 0; i < pageCount; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.setAttribute('aria-label', `Shko te faqja ${i + 1}`);
          dot.addEventListener('click', () => track.scrollTo({ left:i * cardW() * cardsPerView(), behavior:'smooth' }));
          pagination.appendChild(dot);
        }
        updateDots();
      }
      function slide(d){ track.scrollBy({ left:d * cardW() * cardsPerView(), behavior:'smooth' }); }
      root.querySelector('[data-role="prev"]')?.addEventListener('click', () => slide(-1));
      root.querySelector('[data-role="next"]')?.addEventListener('click', () => slide(1));
      let scrollFrame = 0;
      track.addEventListener('scroll', () => {
        if (!scrollFrame) scrollFrame = requestAnimationFrame(() => { scrollFrame = 0; updateDots(); });
      }, { passive:true });
      window.addEventListener('resize', buildDots);
      buildDots();

      track.addEventListener('pointerdown', e=>{
        down=true; moved=false; sx=e.clientX; sl=track.scrollLeft; startTarget = e.target;
        track.setPointerCapture(e.pointerId);
        track.style.cursor='grabbing';
        window.__g_dragging = false;
      });
      track.addEventListener('pointermove', e=>{
        if(!down) return;
        const dx = e.clientX - sx;
        if (Math.abs(dx) > 4) { moved = true; window.__g_dragging = true; }
        track.scrollLeft = sl - dx;
      });
      function end(){
        if(!down) return;
        down=false; track.style.cursor='';
        setTimeout(()=>{ window.__g_dragging = false; }, 50);
        if (!moved) window.__openLightbox(startTarget);
      }
      track.addEventListener('pointerup', end);
      track.addEventListener('pointercancel', end);
      track.addEventListener('mouseleave', end);
    }

    // ---- Modal controls
    btnClose.addEventListener('click', close);
    btnNext.addEventListener('click', next);
    btnPrev.addEventListener('click', prev);
    modal.addEventListener('click', (e)=>{ if (e.target === modal) close(); });

    // ---- Keyboard
    document.addEventListener('keydown', (e)=>{
      if (modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') next();
      if (e.key === 'ArrowLeft') prev();
    });

    // ---- Swipe inside modal
    let tsX=0, tsY=0;
    modal.addEventListener('touchstart', e=>{ const t=e.changedTouches[0]; tsX=t.clientX; tsY=t.clientY; }, {passive:true});
    modal.addEventListener('touchend', e=>{
      const t=e.changedTouches[0];
      const dx=t.clientX-tsX, dy=t.clientY-tsY;
      if (Math.abs(dx) > 40 && Math.abs(dy) < 60) { dx<0 ? next() : prev(); }
    }, {passive:true});
  })();
</script>


<style>
  .g-image { max-width:90vw; max-height:78vh; object-fit:contain; user-select:none; -webkit-user-select:none; }
  .gallery-shell { width:100%; padding-inline:clamp(2.75rem,4vw,4.25rem); }
  .gallery-stage > [data-role="prev"],
  .gallery-stage > [data-role="next"] { display:grid; place-items:center; top:60%; width:2.5rem; height:3.5rem; padding:0!important; border:0; border-radius:0; background:transparent!important; color:transparent!important; line-height:0; transform:translateY(-50%); }
  .gallery-stage > [data-role="prev"] { left:calc(clamp(2.75rem,4vw,4.25rem) * -1)!important; }
  .gallery-stage > [data-role="next"] { right:calc(clamp(2.75rem,4vw,4.25rem) * -1)!important; }
  .gallery-stage > [data-role="prev"]::after,
  .gallery-stage > [data-role="next"]::after { display:block; color:#fff; font-family:Georgia,serif; font-size:3rem; font-weight:300; line-height:1; transform:translateY(-.03em); transition:color .2s ease,transform .2s ease; }
  .gallery-stage > [data-role="prev"]::after { content:"‹"; }
  .gallery-stage > [data-role="next"]::after { content:"›"; }
  .gallery-stage > [data-role="prev"]:hover::after,
  .gallery-stage > [data-role="next"]:hover::after { color:var(--color-gold-bright); }
  .g-counter { margin:.65rem 0 0; color:rgba(255,255,255,.72); font-size:.9rem; text-align:center; }
  .g-modal { z-index:2147483647!important; background:rgba(0,0,0,.92)!important; }

  .lightboxButton{
    font-size: 2.5rem !important;
  }
  .work-gallery { margin-top:clamp(4rem,6vw,6rem); padding-bottom:clamp(3rem,5vw,4.5rem); display:flex; flex-direction:column; justify-content:center; }
  .gallery_title { margin:0 0 2rem; color:#fff; font-family:"Playfair Display",Georgia,serif; font-size:clamp(2.4rem,3.4vw,3.35rem); font-weight:400; line-height:1; }

  .g-track { scrollbar-width:none; touch-action:pan-x; cursor:grab; user-select:none; -webkit-user-select:none; }
  .g-track::-webkit-scrollbar { display: none; }
  .g-pagination { min-height:1rem; margin-top:1.6rem; display:flex; justify-content:center; align-items:center; gap:.65rem; }
  .g-pagination :global(button) { width:.55rem; height:.55rem; padding:0; border:1px solid rgba(212,177,106,.72); border-radius:50%; background:rgba(212,177,106,.18); cursor:pointer; opacity:.55; transition:width .25s ease,background .25s ease,border-color .25s ease,opacity .25s ease; }
  .g-pagination :global(button.is-active) { width:1.65rem; border-radius:999px; border-color:var(--color-gold-bright); background:var(--color-gold-bright); opacity:1; }


  /* 1 / 2 / 3 / 4 per view based on container width */
  .g-card { width: 100%; aspect-ratio: 16/10; scroll-snap-align: start; overflow: hidden; }
  @media (min-width: 640px)  { .g-card { width: 50%; } }        /* ~2 */
  @media (min-width: 1024px) { .g-card { width: 33.333%; } }    /* ~3 */
  @media (min-width: 1280px) { .g-card { width: calc(33.333% - .7rem); } }

  /* optional: keep images contained */
  .g-card img { width:100%; height:100%; object-fit:cover; display:block; user-select:none; -webkit-user-select:none; -webkit-user-drag:none; }

  @media(min-width:521px) and (max-width:900px) {
    .g-modal { box-sizing:border-box; padding:4rem 3.5rem 2rem; }
    .g-modal figure { width:min(100%,700px); }
    .g-image { width:100%; max-width:100%; max-height:56svh; }
    .g-modal [data-role="close"] { top:1rem; right:1.25rem; }
    .g-modal [data-role="mprev"] { left:.85rem; }
    .g-modal [data-role="mnext"] { right:.85rem; }
    .g-modal .lightboxButton { font-size:2rem!important; }
  }

  @media(max-width:620px){
    .work-gallery{margin-top:3.5rem;padding-bottom:3rem}
    .gallery-shell{padding-inline:2.25rem}
    .gallery-stage > [data-role="prev"] { left:-2.25rem!important; }
    .gallery-stage > [data-role="next"] { right:-2.25rem!important; }
    .gallery-stage > [data-role="prev"]::after,.gallery-stage > [data-role="next"]::after{font-size:2.5rem}
  }
  @media(max-width:500px){
    .gallery_title { text-align:center; }
    .gallery-shell { padding-inline:3rem; }
    .gallery-stage > [data-role="prev"],
    .gallery-stage > [data-role="next"] {
      display:grid;
      place-items:center;
      top:60%;
      width:2.5rem;
      height:3.5rem;
      text-align:center;
    }
    .gallery-stage > [data-role="prev"] { left:-3rem!important; }
    .gallery-stage > [data-role="next"] { right:-3rem!important; }
    .gallery-stage > [data-role="prev"]::after,
    .gallery-stage > [data-role="next"]::after { display:block; width:1em; text-align:center; }
    .g-modal { box-sizing:border-box; padding:4rem 3.25rem 2rem; }
    .g-modal figure { width:100%; max-width:28rem; }
    .g-image { width:100%; max-width:100%; max-height:58svh; object-fit:contain; }
    .g-modal [data-role="close"] { top:1rem; right:1rem; }
    .g-modal [data-role="mprev"] { left:.6rem; }
    .g-modal [data-role="mnext"] { right:.6rem; }
    .g-modal .lightboxButton { font-size:2rem!important; }
  }

  @media(max-width:390px){
    .gallery-shell { padding-inline:1.75rem; }
    .gallery-stage > [data-role="prev"],
    .gallery-stage > [data-role="next"] {
      top:60%;
      width:1.75rem;
      height:2.75rem;
    }
    .gallery-stage > [data-role="prev"] { left:-1.75rem!important; }
    .gallery-stage > [data-role="next"] { right:-1.75rem!important; }
    .gallery-stage > [data-role="prev"]::after,
    .gallery-stage > [data-role="next"]::after { font-size:2rem; }
    .g-pagination {
      min-height:.8rem;
      margin-top:1rem;
      gap:.45rem;
    }
    .g-pagination :global(button) {
      width:.42rem;
      height:.42rem;
      border-color:rgba(216,174,91,.85);
      background:rgba(216,174,91,.16);
    }
    .g-pagination :global(button.is-active) {
      width:1.25rem;
      background:var(--color-gold-bright);
    }
  }

</style>

<style is:global>
  body.gallery-lightbox-open #navbar { z-index:1!important; }
</style>
