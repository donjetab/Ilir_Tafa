---
import Header from '../Header.astro';
import heroImg from '../../assets/hero.png';
import { localeFromPath, localizedUrl } from '../../i18n';

const locale = localeFromPath(Astro.url.pathname);
const copy = {
  sq: { subtitle: 'Aktori më i njohur i teatrit dhe filmit nga Kosova', cta: 'VEPRIMTARIA' },
  en: { subtitle: 'Renowned theatre and film actor from Kosovo', cta: 'VIEW WORKS' },
  bs: { subtitle: 'Istaknuti pozorišni i filmski glumac sa Kosova', cta: 'POGLEDAJ DJELA' },
}[locale];
---

<Header overlay />
<section class="hero" aria-labelledby="hero-title">
  <img class="hero__image" src={heroImg.src} alt="Ilir Tafa" fetchpriority="high" />
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__melt" aria-hidden="true"></div>
  <div class="hero__content">
    <h1 id="hero-title" class="hero__title fade-up fade-200">Ilir Tafa</h1>
    <p class="hero__subtitle fade-up fade-300">{copy.subtitle}</p>
    <a href={localizedUrl(locale, 'works')} class="btn-gold fade-up fade-300">{copy.cta}</a>
  </div>
</section>
<div class="hero-transition" aria-hidden="true"></div>

<style>
  .hero {
    position: relative;
    width:100%;
    min-height:100svh;
    overflow: hidden;
    isolation: isolate;
    background: #000;
  }
  .hero__image, .hero__shade { position:absolute; inset:0; width:100%; height:100%; }
  .hero__image { z-index:-3; object-fit:cover; object-position:center center; filter:saturate(0) contrast(1.05); }
  .hero__shade {
    z-index:-1;
    background:
      linear-gradient(90deg, rgba(0,0,0,.08) 20%, rgba(0,0,0,.04) 47%, rgba(0,0,0,.6) 100%),
      linear-gradient(180deg, transparent 42%, rgba(0,0,0,.12) 52%, rgba(0,0,0,.42) 66%, rgba(0,0,0,.82) 82%, #000 96%);
  }
  .hero__melt { position:absolute; z-index:-1; left:0; right:0; bottom:-1px; height:54%; background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.08) 14%,rgba(0,0,0,.24) 30%,rgba(0,0,0,.5) 49%,rgba(0,0,0,.76) 66%,rgba(0,0,0,.94) 82%,#000 100%); pointer-events:none; }
  .hero-transition { width:100%; height:clamp(180px,14vw,280px); margin-top:-1px; background:linear-gradient(180deg,#000 0%,#010203 30%,#030609 62%,#070b10 100%); }
  .hero__content {
    position:absolute;
    left:50%;
    top:51%;
    width:50%;
    transform:translateY(-50%);
    text-align:center;
  }
  .hero__title { color:var(--color-gold-bright); font-size:clamp(5rem, 7.5vw, 8.5rem); line-height:.9; font-weight:500; }
  .hero__subtitle { margin:.85rem 0 0; font-size:clamp(.86rem, .95vw, 1rem); line-height:1.45; color:rgba(255,255,255,.9); }
  .hero__content .btn-gold { margin-top:1.65rem; min-width:150px; padding:.72rem 1.6rem; font-size:.76rem; }
  @media (max-width: 800px) {
    .hero { min-height:100svh; height:100svh; }
    .hero__image { left:0; top:0; width:100%; height:78%; transform:none; object-fit:cover; object-position:30% 35%; }
    .hero__shade {
      background:
        linear-gradient(180deg,rgba(0,0,0,.16) 0%,transparent 18%),
        linear-gradient(180deg,transparent 34%,rgba(0,0,0,.12) 46%,rgba(0,0,0,.72) 66%,#000 82%);
    }
    .hero__melt { height:62%; background:linear-gradient(180deg,transparent 0%,rgba(0,0,0,.08) 18%,rgba(0,0,0,.48) 45%,rgba(0,0,0,.9) 68%,#000 84%); }
    .hero__content { left:50%; top:auto; bottom:max(5.5%,env(safe-area-inset-bottom)); width:min(90%,520px); transform:translateX(-50%); padding:0 .5rem; }
    .hero__title { font-size:clamp(4rem, 18vw, 5.8rem); line-height:.88; white-space:nowrap; }
    .hero__subtitle { max-width:340px; margin:.9rem auto 0; font-size:clamp(.82rem,3.7vw,.95rem); line-height:1.5; }
    .hero__content .btn-gold { min-width:145px; margin-top:1.4rem; padding:.68rem 1.35rem; }
    .hero-transition { height:120px; }
  }
  @media (max-width:800px) and (max-height:680px) {
    .hero__image { height:74%; object-position:30% 30%; }
    .hero__content { bottom:max(3.5%,env(safe-area-inset-bottom)); }
    .hero__title { font-size:clamp(3.5rem,16vw,4.8rem); }
    .hero__subtitle { margin-top:.65rem; }
    .hero__content .btn-gold { margin-top:1rem; }
  }
</style>
