---
import type { ImageMetadata } from "astro";

interface Item {
  id: string;
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  tags?: string[];
  workSlug?: string;
}

const { items = [] as Item[], moreLabel = "MË SHUMË" } = Astro.props;
---
<!-- Centering wrapper -->
<div id="gallery-viewport" class="gallery-viewport">
<div class="gallery-wrap">
  <!-- Columns box with explicit widths -->
  <div
    id="gallery-grid"
    class="gallery-grid columns-1 sm:columns-2 lg:columns-3 [column-fill:_balance]"
  >
    {
      items.map((it: Item, i: number) => {
        return (
          <button
            type="button"
            class="gallery-item w-full break-inside-avoid relative group focus:outline-none cursor-pointer"
            data-index={i}
            aria-label={`Open ${it.alt ?? 'image'}`}
          >
            <img
              src={it.src.src}
              width={it.src.width}
              height={it.src.height}
              alt={it.alt ?? ''}
              loading="lazy"
              class="w-full h-auto rounded-xl object-cover shadow-md transition hover:opacity-90"
            />
            {(it.caption || (it.tags && it.tags.length > 0)) && (
              <div class="absolute inset-x-2 bottom-2 rounded-md bg-black/55 text-white p-2 opacity-0 group-hover:opacity-100 transition">
                {it.caption && <p class="text-sm leading-snug">{it.caption}</p>}
                {it.tags && it.tags.length > 0 && (
                  <div class="mt-1 flex flex-wrap gap-1">
                    {it.tags.map((t) => (
                      <span class="text-[11px] px-2 py-0.5 rounded-full bg-white/15">{t}</span>
                    ))}
                  </div>
                )}
              </div>
            )}
          </button>
        );
      })
    }
  </div>
</div>
</div>

{items.length > 6 && <button type="button" id="gallery-more" class="gallery-more">{moreLabel}</button>}


<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/90">
  <button id="lb-close" class="absolute top-4 right-4 text-white text-3xl lightboxButton" aria-label="Close">×</button>
  <button id="lb-prev"  class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white text-2xl lightboxButton" aria-label="Previous">❮</button>
  <button id="lb-next"  class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white text-2xl lightboxButton" aria-label="Next">❯</button>

  <figure class="max-w-[92vw] max-h-[86vh] flex flex-col items-center justify-center">
    <img id="lb-img" alt="" class="mx-auto max-h-[70vh] w-auto object-contain rounded-lg shadow-2xl" />
    <figcaption id="lb-cap" class="mt-3 text-center text-white/90 text-sm"></figcaption>
  </figure>
</div>

<script is:inline>
  // Ensure DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('gallery-grid');
    const viewport = document.getElementById('gallery-viewport');
    const lb = document.getElementById('lightbox');
    const lbImg = document.getElementById('lb-img');
    const lbCap = document.getElementById('lb-cap');
    const btnClose = document.getElementById('lb-close');
    const btnPrev  = document.getElementById('lb-prev');
    const btnNext  = document.getElementById('lb-next');
    const btnMore = document.getElementById('gallery-more');

    // Build state from rendered buttons
    const buttons = Array.from(grid?.querySelectorAll('button[data-index]') ?? []);
    const phoneGallery = window.matchMedia('(max-width: 520px)').matches;
    const tabletGallery = window.matchMedia('(min-width: 521px) and (max-width: 900px)').matches;
    const galleryBatchSize = phoneGallery ? 4 : tabletGallery ? 6 : 9;
    let visibleCount = Math.min(galleryBatchSize, buttons.length);
    const state = {
      items: buttons.map((btn) => {
        const img = btn.querySelector('img');
        const capEl = btn.querySelector('div > p');
        const tagEls = btn.querySelectorAll('div span');
        return {
          src: img?.getAttribute('src') ?? '',
          alt: img?.getAttribute('alt') ?? '',
          caption: capEl?.textContent ?? '',
          tags: Array.from(tagEls).map((s) => s.textContent ?? ''),
        };
      }),
      i: 0,
    };

    function show(i) {
      if (!state.items.length) return;
      state.i = (i + state.items.length) % state.items.length;
      const item = state.items[state.i];
      lbImg?.setAttribute('src', item.src);
      lbImg?.setAttribute('alt', item.alt || '');
      const cap = [item.caption, ...(item.tags?.length ? ['#' + item.tags.join('  #')] : [])]
        .filter(Boolean).join(' · ');
      if (lbCap) lbCap.textContent = cap;
    }
    function open(i) {
      show(i);
      lb?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lb?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Delegated click open
    grid?.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const btn = target ? target.closest('button[data-index]') : null;
      if (!btn) return;
      const idx = Number(btn.getAttribute('data-index') ?? '0');
      open(idx);
    });

    // Controls
    btnClose?.addEventListener('click', close);
    lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
    btnPrev?.addEventListener('click', () => show(state.i - 1));
    btnNext?.addEventListener('click', () => show(state.i + 1));
    document.addEventListener('keydown', (e) => {
      if (lb?.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(state.i - 1);
      if (e.key === 'ArrowRight') show(state.i + 1);
    });
    function heightForVisibleItems(count) {
      if (!grid || !buttons.length) return 0;
      const gridTop = grid.getBoundingClientRect().top;
      return Math.max(...buttons.slice(0, count).map((item) => item.getBoundingClientRect().bottom - gridTop));
    }

    function setGalleryHeight(animate = false) {
      if (!viewport || !grid || buttons.length <= visibleCount) return;
      if (!animate) viewport.style.transition = 'none';
      viewport.style.height = `${heightForVisibleItems(visibleCount)}px`;
      if (!animate) requestAnimationFrame(() => viewport.style.removeProperty('transition'));
    }

    if (buttons.length > visibleCount) {
      const images = Array.from(grid?.querySelectorAll('img') ?? []);
      Promise.all(images.map((image) => image.complete
        ? Promise.resolve()
        : new Promise((resolve) => {
            image.addEventListener('load', resolve, { once: true });
            image.addEventListener('error', resolve, { once: true });
          })
      )).then(() => setGalleryHeight(false));
      window.addEventListener('resize', () => setGalleryHeight(false));
    } else {
      btnMore?.remove();
    }

    btnMore?.addEventListener('click', () => {
      if (!viewport || !grid) return;
      visibleCount = Math.min(visibleCount + galleryBatchSize, buttons.length);
      viewport.style.height = `${heightForVisibleItems(visibleCount)}px`;
      if (visibleCount === buttons.length) {
        viewport.addEventListener('transitionend', () => {
          viewport.style.height = 'auto';
          btnMore.remove();
        }, { once: true });
      }
    });
  });
</script>


<style>
  #lightbox { z-index:2147483647!important; }
  .gallery-viewport {
    width: 100%;
    overflow: hidden;
    transition: height .75s cubic-bezier(.22, 1, .36, 1);
  }
  .gallery-wrap { display: flex; justify-content: center; width: 100%; }
  .gallery-grid { width: 100%; column-gap: clamp(1rem, 2vw, 1.75rem); text-align: left; }
  .gallery-item { margin-bottom: clamp(1rem, 2vw, 1.75rem); }
  .gallery-more {
    min-width: 190px;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    padding: .8rem 2.4rem;
    border: 1px solid #cda94f;
    border-radius: 5px;
    color: #d9b75c;
    background: transparent;
    font-size: .82rem;
    letter-spacing: .04em;
    transition: color .2s ease, background-color .2s ease, transform .2s ease;
  }
  .gallery-more:hover { color: #070b10; background: #d9b75c; transform: translateY(-2px); }
  .lightboxButton{
    font-size: 2.5rem !important;
  }
</style>
