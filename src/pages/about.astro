---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AboutHero from "../components/about/AboutHero.astro";
import AboutSplit from "../components/about/AboutSplit.astro";
import AboutAwards from "../components/about/AboutAwards.astro";
import AboutQuote from "../components/about/AboutQuote.astro";
import { localeFromPath } from '../i18n';

// import imazhet reale
import hero from "../assets/about-header.jpg";
import academicIcon from "../assets/about-1.png";
import theatreIcon from "../assets/about-2.png";
import filmIcon from "../assets/about-3.png";
import cultureIcon from "../assets/about-4.png";
import awardIcon1 from "../assets/award-icon-1.png";
import awardIcon2 from "../assets/award-icon-2.png";
import awardIcon3 from "../assets/award-icon-3.png";
import awardIcon4 from "../assets/award-icon-4.png";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const headerIntro = `Ilir Tafa, i lindur më 1974 në Lipjan, është një nga aktorët më të njohur nga Kosova, me një karrierë të ndërtuar në teatër, film, televizion dhe arsim të lartë. Veprimtaria e tij artistike është shtrirë përtej Kosovës, duke e bërë të njohur edhe në Bosnje e Hercegovinë, Kroaci dhe vende të tjera të rajonit.`;

const items = [
  {
    icon: academicIcon,
    title: "Formimi dhe angazhimi akademik",
    paragraphs: [
      "Interesimi i Tafës për artin dramatik u zhvillua që në moshë të re. Ai studioi aktrim në Fakultetin e Arteve të Universitetit të Prishtinës gjatë viteve 1995–1998, ndërsa më pas vazhdoi studimet pasuniversitare dhe në vitin 2008 përfundoi gradën Master i Arteve në fushën e aktrimit.",
      "Përvoja e tij artistike është ndërthurur edhe me angazhimin akademik. Tafa ka ligjëruar lëndë praktike të aktrimit, përfshirë Diksionin dhe Interpretimin, në Kolegjin AAB në Prishtinë. Ai është gjithashtu një nga figurat themeluese të institucionit dhe ka mbajtur rol drejtues në Këshillin Drejtues të Kolegjit AAB."
    ]
  },
  {
    icon: theatreIcon,
    title: "Teatri",
    paragraphs: [
      "Karriera e tij profesionale nisi në skenën teatrore kosovare. Ndër paraqitjet e hershme përfshihen shfaqjet Alo 038 dhe Studio 2, të realizuara në vitin 1995. Më vonë ai u paraqit në monodramën Sonte jam vetëm dhe në një sërë produksionesh të tjera teatrore.",
      "Në vitin 2012 interpretoi në komedinë Killing Me Softly në Teatrin Dodona, ndërsa në vitin 2018 u paraqit në komedinë dramatike Bretkosa në Teatrin “Faruk Begolli” të Kolegjit AAB, me regji të Burbuqe Berishës. Shfaqja trajton përmes elementeve komike dhe dramatike pasojat psikologjike dhe sociale të periudhës së pasluftës dhe vështirësitë e komunikimit mes njerëzve."
    ]
  },
  {
    icon: filmIcon,
    title: "Film dhe televizion",
    paragraphs: [
      "Tafa ka ndërtuar një filmografi të gjerë që përfshin produksione kosovare dhe rajonale. Në vitet 1990 dhe 2000 ai u paraqit në filma dhe seriale si Atje ku nuk lind dielli, Shtëpia e tmerrit, Kamera me yjet, Kandidati për president, Kaçurrelët dhe Zogjtë e luftës.",
      "Një nga rolet që e bëri veçanërisht të njohur në rajon ishte ai i Mentor Kosovës në sitcomin boshnjak Lud, Zbunjen, Normalan, ku interpretoi gjatë periudhës 2010–2016. Përmes këtij personazhi, Tafa fitoi një audiencë të gjerë në Bosnje e Hercegovinë, Kroaci dhe Serbi.",
      "Në vitin 2016 ai luajti një nga rolet kryesore në filmin Terorista, të xhiruar në Sarajevë dhe Budapest. Një vit më vonë u paraqit në Festivalin e Filmit në Sarajevë me projektet Invisible dhe Žaba (Bretkosa). Në filmografinë e tij përfshihen gjithashtu The Life of Flowers, Kodi i jetës, seriali historik-komik Konak kod Hilmije dhe seriali kosovar Tre Vllaznit."
    ]
  },
  {
    icon: cultureIcon,
    title: "Diplomacia kulturore dhe përfaqësimi i Kosovës",
    paragraphs: [
      "Puna e Tafës në produksionet rajonale ka pasur ndikim edhe përtej dimensionit artistik. Një analizë akademike e vitit 2022 mbi diplomacinë kulturore të Kosovës e përmend rolin e tij në Lud, Zbunjen, Normalan si një shembull të mënyrës se si arti dhe kultura mund të kontribuojnë në prezantimin e Kosovës para audiencave ndërkombëtare.",
      "Përmes personazhit Mentor Kosova, në serial u përfshinë gjuha shqipe, muzika dhe elemente të kulturës kosovare, ndërsa vetë produksioni transmetohej në disa vende të rajonit. Në këtë mënyrë, prania e Tafës në një nga serialet më të njohura të Ballkanit shërbeu edhe si një formë e komunikimit kulturor të Kosovës me publikun rajonal."
    ]
  }
];

const awards = [
  { icon: awardIcon1, title: "‘Aktori më i Mirë’", festival: "Festivali i Filmit në Gjilan" },
  { icon: awardIcon2, title: "‘Aktori më i Mirë’", festival: "Festivali i Komedisë Shqiptare në Preshevë" },
  { icon: awardIcon3, title: "‘Aktori më i Mirë’", festival: "Festivali Ballkanik i Teatrit në Prishtinë" },
  { icon: awardIcon4, title: "‘Aktori më i Mirë’", festival: "Festivali i Teatrove Shqiptare në Dibër të Maqedonisë" },
];


---
<!doctype html>
<html lang={localeFromPath(Astro.url.pathname)} class="scroll-smooth">
  <head>

    <BaseHead title={title} description={description} />
  </head>
  <body class="about-page font-sans antialiased">
    <main id="main" class="min-h-screen">
        <Header overlay />
        <AboutHero hero={hero} name="Ilir Tafa" intro={headerIntro} />
        <AboutSplit items={items} />
        <AboutAwards awards={awards} />
        <AboutQuote
          quote="Ta ndërtosh një teatër si ‘Faruk Begolli’ është si të ndërtosh një kishë a xhami, bile më vështirë... Ky njeri, Ilir Tafa, është patriot i ditëve të sotit."
          author="Enver Petrovci për Ilir Tafën"
        />
        <div class="about-footer-separator" aria-hidden="true"></div>
    </main>
    <Footer />
  </body>
</html>
 

<style is:global>
  html {
    background: #070b10;
  }

  body.about-page {
    min-height: 100%;
    color: #f5f5f5;
    background: linear-gradient(
      180deg,
      #070b10 75%,
      #090e14 100%
    );
    background-attachment: fixed;
  }

  .about-footer-separator {
    min-height: clamp(10rem, 14vw, 14rem);
    border-bottom: 1px solid rgba(216, 174, 91, 0.58);
    background: #090e14;
  }

  @media (max-width: 620px) {
    .about-footer-separator {
      min-height: 7rem;
    }
  }
</style>
