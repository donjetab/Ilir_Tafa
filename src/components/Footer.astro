---
// Footer.astro
import logo from "../assets/logo nobg.png";
const year = new Date().getFullYear();
const nav = [
  { href: "", label: "Ballina" },
  { href: "about", label: "Biografia" },
  { href: "works", label: "Veprimtaria" },
  { href: "gallery", label: "Galeri" },
  { href: "news", label: "Lajme" },
]
const accent = "text-[#D4AF37]";
---

<footer class="w-full bg-[#1c2733] text-white border-t border-white/10 min-h-[200px] flex flex-col justify-between">
  <!-- TOP -->
  <div class="flex-1 mx-auto max-w-[100%] px-20 py-24" style="padding: 30px;">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      <!-- Left: about -->
      <div class="md:col-span-3 text-center md:text-left">
        <h3 class="text-sm uppercase tracking-widest text-white/70">Ilir Tafa</h3>
        <p class="mt-3 text-base text-white/70 leading-relaxed">
          Aktor teatri dhe filmi nga Kosova.<br />
          Projekte, lajme dhe kontakt zyrtar.
        </p>
      </div>

      <!-- Center: brand -->
      <div class="md:col-span-6 flex flex-col items-center justify-center">
        <div class="relative">
          <a href={import.meta.env.BASE_URL} class="block">
            <img
              src={logo.src}
              width="108"
              height="108"
              alt="Ilir Tafa logo"
              class="h-24 w-24 object-contain opacity-95"
            />
            </a>
          <span class="pointer-events-none absolute inset-0 rounded-full ring-1 ring-white/10"></span>
        </div>
        <!-- <p class="mt-6 text-base text-white/60">Ndjek artin. Mbështet teatrin.</p> -->
      </div>

      <!-- Right: contact -->
      <div class="md:col-span-3 text-center md:text-right">
        <h3 class="text-sm uppercase tracking-widest text-white/70">Kontakti</h3>
        <p class="mt-3 text-base">
          /
          <!-- <a href="mailto:" class={`hover:${accent} transition`}>donjeta.bajgora@aab-edu.com</a> -->
        </p>
        <p class="text-base text-white/70">Prishtinë, Kosovë</p>
      </div>
    </div>
  </div>

  <!-- BOTTOM BAND -->
  <div class="bg-[#1c2733] border-t border-white/10">
    <div class="mx-auto max-w-[100%] px-12 py-6" style="padding: 10px 30px;">
      <div class="grid items-center gap-6 md:grid-cols-[1fr_auto_1fr]">
        <!-- Left: copyright -->
        <p class="order-3 md:order-1 text-xs md:text-sm text-white/60 text-center md:text-left">
          © {year} Ilir Tafa. Administuar nga <a href="mailto: donjeta.bajgora@aab-edu.net" class={`hover:${accent} transition`}>D.B.</a> 
        </p>

        <!-- Center: nav -->
        <nav aria-label="Navigimi" class="order-1 md:order-2 justify-self-center">
          <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
            {nav.map((n) => (
              <li>
                <a href={n.href} class={`text-white/70 hover:${accent} transition`}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Right: social -->
        <div class="order-2 md:order-3 flex justify-center md:justify-end gap-3">
          <a href="https://www.instagram.com/ilirtafa/" aria-label="Instagram" target="_blank" class="group p-2 rounded-full bg-white/5 hover:bg-white/10 ring-1 ring-white/10">
            <svg viewBox="0 0 24 24" class="h-5 w-5"><path fill="currentColor" d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5m5 5a5 5 0 1 0 0 10a5 5 0 0 0 0-10m6.5-.25a1.25 1.25 0 1 0 0 2.5a1.25 1.25 0 0 0 0-2.5M12 9a3 3 0 1 1 0 6a3 3 0 0 1 0-6"/></svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=100050606764195" target="_blank" aria-label="Facebook" class="group p-2 rounded-full bg-white/5 hover:bg-white/10 ring-1 ring-white/10">
            <svg viewBox="0 0 24 24" class="h-5 w-5"><path fill="currentColor" d="M22 12.06A10 10 0 1 0 10 22V14H7v-3h3V8.5A4.5 4.5 0 0 1 14.5 4h3.5v3h-3.5A1.5 1.5 0 0 0 13 8.5V11h4l-1 3h-3v8A10 10 0 0 0 22 12.06"/></svg>
          </a>
          <!-- <a href="https://youtube.com" aria-label="YouTube" class="group p-2 rounded-full bg-white/5 hover:bg-white/10 ring-1 ring-white/10">
            <svg viewBox="0 0 24 24" class="h-5 w-5"><path fill="currentColor" d="M10 15V9l5 3m10-3s0-3-1-4c-1-1-4-1-6-1H7C5 4 2 4 1 5S0 9 0 9s0 3 1 4s4 1 6 1h11c2 0 5 0 6-1s1-4 1-4"/></svg>
          </a> -->
        </div>
      </div>
    </div>
  </div>
</footer>
