---
interface Props {
  quote: string;
  author?: string;
}
const { quote, author = "Ilir Tafa" } = Astro.props;
---
<section class="quoteS flex items-center justify-center min-h-[60vh] px-6 py-20">
  <figure class="quote text-center rounded-2xl bg-[#18222c] text-white p-10 md:p-14 shadow-lg">
    <blockquote class="text-2xl md:text-4xl font-light leading-snug tracking-tight">
      “{quote}”
    </blockquote>
    <figcaption class="mt-6 text-white/60 text-sm md:text-base">
      — {author}
    </figcaption>
  </figure>
</section>

<style>
    .quote{
      width: 55% !important;
      padding: 60px !important;
    }

    @media (max-width:1024px){
      .quoteS{
        min-height: 60vh;
      }
      .quote{
      width: 65% !important;
    }
      blockquote{
        font-size: 20px;
      }
      figcaption{
        font-size: 15px;
      }
    }
    @media (max-width:640px){
    .quote{
      width: 85% !important;
      padding: 30px !important;
    }
    blockquote{
      font-size: 20px;
    }
    figcaption{
      padding-top: 10px;
    }
  }

</style>
