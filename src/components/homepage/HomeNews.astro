---
// load files
const entries = await import.meta.glob("../../content/news/*.json", { eager: true, import: "default" });

type NewsPost = {
  type?: "internal" | "external";
  date?: string;
  slug: string;
  cover?: string;
  title?: string;
  excerpt?: string;
  sourceUrl?: string;
};

// normalize + add slug from filename
const posts: NewsPost[] = Object.entries(entries).map(([file, p]: [string, any]) => {
  const fileSlug = file.split("/").pop()?.replace(".json", "") ?? "";
  return {
    slug: p?.slug ?? fileSlug,
    type: p?.type,
    sourceUrl: p?.sourceUrl,
    date: p?.date ?? "",
    cover: p?.cover ?? "",
    title: p?.title ?? "",
    excerpt: p?.excerpt ?? "",
  };
});

// pick by slug
const wanted = new Set(["bretkosat-teatri-prizren", "abasadori-kulturor-i-evropes"]);
const items = posts.filter(p => wanted.has(p.slug));

// fallback if none found
const safeItems = items.length ? items : posts.slice(0, 2);
---


<section class="news w-full h-screen bg-[#0e141a] text-white flex flex-col items-center justify-center text-center gap-20">
  <h2 class=" text-3xl md:text-5xl font-semibold title mt-10">LAJMET E FUNDIT</h2>
  <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-12 px-12 text-left">
    {safeItems.map((n) => (
      <a
        href={n.sourceUrl || `/lajmet/${n.slug}`}
        target={n.type === "external" ? "_blank" : "_self"}
        rel={n.type === "external" ? "noopener noreferrer" : undefined}
        class="flex items-center justify-center gap-6 w-full group"
      >
        <!-- Image -->
        <div class="w-48 h-48 lg:w-56 lg:h-56 rounded-[28px] overflow-hidden flex-shrink-0 bg-[#1c2733]">
          <img
            src={n.cover}
            alt={n.title}
            class="w-full h-full object-cover object-center"
            style="aspect-ratio: 1/1; display: block;"
          />
        </div>


        <!-- Text -->
        <div class="max-w-md">
          <h3 class="text-xl md:text-2xl font-medium mb-2 group-hover:text-[#d4af37] transition-colors" style="font-size: 1.3rem; font-weight: 500;">
            {n.title}
          </h3>

          <!-- paragraph (shown even for external links) -->
          <p class="text-sm md:text-base leading-relaxed text-[#d4dbe1]" style="margin-top: 10px;">
            {n.excerpt}
          </p>

        </div>
      </a>
    ))}
</div>

  <a href="news" class="btn-gold mt-4">MË SHUMË</a>
</section>


<style>


/* Mobile ≤640px: stack image above text, full width image */
@media (max-width:640px){
  /* Base: let section grow and center grid container */
.news{ 
    margin-top: 100px;
    margin-bottom: 100px;
  height:auto; min-height:100vh; padding-block:3rem; gap: 40px; }
.news .grid{ max-width:1100px; margin-inline:auto; }

/* Card look */
.news a{
  background:#101923;
  border:1px solid #243241;
  border-radius:20px;
  padding:16px;
  transition:transform .2s ease;
}
.news a:hover{ transform:translateY(-2px); }
.news a h3{ margin:0; }
.news a p{ margin:8px 0 0; }
  .news{ justify-content:flex-start; text-align:left; }
  .news .grid{ grid-template-columns:1fr; gap:30px; padding-inline:16px; }

  .news a{ flex-direction:column; align-items:stretch; gap:12px; }
  .news a > div:first-child{ width:100%; height:200px; border-radius:18px; overflow:hidden; }
  .news a img{ width:100%; height:180%; object-fit:cover; }
  .news .title{ font-size: 50px; margin-bottom:0rem; }
.btn-gold {
    padding: 0.85rem 2.5rem !important;
    border-radius: 9999px !important;
    border: 3.5px solid #d4b16a !important;
    background-color: #1c2229 !important;
  margin-top: 0px;
}
}

/* ≥641px: keep side-by-side with consistent image size */
@media (min-width:641px){
  .news a > div:first-child{ width:224px; height:224px; } /* ~ w-56 h-56 */
}

</style>