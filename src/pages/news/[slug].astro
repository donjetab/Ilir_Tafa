---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { localeFromPath, localizedUrl } from '../../i18n';
import sadSide from "../../assets/sad-side.png";
import happySide from "../../assets/happy-side.png";

type Post = {
  type?: "internal" | "external"; slug?: string; title: string; excerpt?: string;
  date?: string; cover?: string; contentHtml?: string; sourceName?: string;
  dek?: string; author?: string; videoUrl?: string; showVideoOnly?: boolean;
};

export async function getStaticPaths() {
  const posts = import.meta.glob("../../content/news/*.json", { eager:true, import:"default" });
  return Object.entries(posts).map(([file,value]) => {
    const post = value as Post;
    if (post.type !== "internal") return null;
    const fileSlug = file.split("/").pop()?.replace(".json", "");
    return { params:{ slug:post.slug ?? fileSlug! }, props:{ post } };
  }).filter(Boolean);
}

const { post:item } = Astro.props as { post:Post };
const locale = localeFromPath(Astro.url.pathname);
const newsUrl = localizedUrl(locale, 'news');
const backLabel = locale === 'en' ? 'Back to News' : locale === 'bs' ? 'Nazad na vijesti' : 'Kthehu te lajmet';
const pageTitle = item.title ?? 'News';
const pageDesc = item.excerpt ?? '';
const formattedDate = item.date
  ? new Intl.DateTimeFormat(locale === 'sq' ? 'sq-AL' : locale === 'bs' ? 'bs-BA' : 'en-GB', { day:'2-digit', month:'2-digit', year:'numeric' }).format(new Date(item.date))
  : null;
---

<html lang={locale}>
  <head><BaseHead title={`${pageTitle} | Ilir Tafa`} description={pageDesc} type="article" image={item.cover} /></head>
  <body>
    <Header />
    <main class="article-page">
      <a class="back-link" href={newsUrl}>&larr; {backLabel}</a>

      <header class="article-heading">
        <img class="article-figure article-figure--left" src={sadSide.src} alt="" aria-hidden="true" />
        <img class="article-figure article-figure--right" src={happySide.src} alt="" aria-hidden="true" />
        <h1>{pageTitle}</h1>
        {formattedDate && <time datetime={item.date}>{formattedDate}</time>}
      </header>

      {item.showVideoOnly && item.videoUrl ? (
        <div class="article-media article-video">
          <video src={item.videoUrl} poster={item.cover} controls preload="metadata"></video>
        </div>
      ) : item.cover ? (
        <figure class="article-media">
          <img src={item.cover} alt={pageTitle} loading="eager" />
        </figure>
      ) : null}

      {(item.dek || item.excerpt || item.contentHtml) && (
        <section class="article-copy">
          {item.dek && <p class="article-dek">{item.dek}</p>}
          {!item.contentHtml && item.excerpt && <p>{item.excerpt}</p>}
          {item.contentHtml && <article set:html={item.contentHtml}></article>}
        </section>
      )}

      <a class="back-link back-link--bottom" href={newsUrl}>&larr; {backLabel}</a>
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(body) { min-height:100vh; margin:0; overflow-x:hidden; color:#f5f5f3; background:linear-gradient(180deg,#070b10 0%,#090e14 50%,#0d1722 100%); background-attachment:fixed; }
  .article-page { width:min(calc(100% - 2rem),1240px); 
    min-height:80vh; margin:auto; 
    padding:clamp(2rem,6vw,3rem) 0 clamp(7rem,10vw,10rem); }
  .back-link { display:inline-flex; gap:.5rem; align-items:center; color:#c9aa69; font-size:.9rem; text-decoration:none; transition:color .2s ease,transform .2s ease; }
  .back-link:hover { color:#fff; transform:translateX(-.25rem); }
  .article-heading { position:relative; isolation:isolate; width:min(100%,1220px); 
  margin:clamp(2rem,6vw,2rem) auto clamp(3rem,5vw,4rem); text-align:center; }
  .article-figure { position:absolute; z-index:-1; top:50%; width:clamp(190px,20vw,320px); height:auto; opacity:.05; filter:blur(.5px); pointer-events:none; user-select:none; }
  .article-figure--left { left:calc(50% - 50vw - 4rem); transform:translateY(-50%) rotate(-4deg); -webkit-mask-image:linear-gradient(90deg,#000 25%,rgba(0,0,0,.7) 62%,transparent); mask-image:linear-gradient(90deg,#000 25%,rgba(0,0,0,.7) 62%,transparent); }
  .article-figure--right { right:calc(50% - 50vw - 4rem); transform:translateY(-50%) rotate(4deg); -webkit-mask-image:linear-gradient(270deg,#000 25%,rgba(0,0,0,.7) 62%,transparent); mask-image:linear-gradient(270deg,#000 25%,rgba(0,0,0,.7) 62%,transparent); }
  .article-heading h1 { margin:0; font-family:"Playfair Display",Georgia,serif; font-size:clamp(2.35rem,4vw,4.15rem); font-weight:400; line-height:1.08; text-wrap:balance; }
  .article-heading time { display:block; margin-top:1rem; font-size:clamp(1.05rem,1.6vw,1.45rem); font-style:italic; color:#c9aa69; }
  .article-media { width:min(100%,1100px); margin:0 auto; overflow:hidden; border:1px solid #c9aa69; border-radius:1.4rem; background:#0b0e13; box-shadow:0 20px 50px rgba(0,0,0,.28); }
  .article-media img { display:block; width:100%; max-height:650px; object-fit:cover; }
  .article-video { aspect-ratio:16/9; }
  .article-video video { display:block; width:100%; height:100%; object-fit:contain; background:#05070a; }
  .article-copy { width:min(100%,1100px); margin:clamp(3rem,5vw,4.5rem) auto 0; color:rgba(255,255,255,.82); font-size:clamp(1rem,1.35vw,1.2rem); line-height:1.58; }
  .article-copy :global(p) { margin:0 0 1.5rem; }
  .article-copy :global(h2),.article-copy :global(h3) { margin:2.5rem 0 1rem; font-family:"Playfair Display",Georgia,serif; color:#fff; }
  .article-dek { color:#fff; font-size:1.1em; font-weight:500; }
  .back-link--bottom { margin-top:clamp(3rem,6vw,5rem); }
  @media(min-width:761px) and (max-width:900px){
    .article-heading h1 { width:min(100%,720px); margin-inline:auto; font-size:2.15rem; }
    .article-figure--left { left:-7rem; }
    .article-figure--right { right:-7rem; }
    .article-media { width:min(100%,780px); }
  }
  @media(max-width:600px){
    .article-page { padding-top:2.5rem; }
    .article-heading { margin-top:2.5rem; }
    .article-heading h1 { font-size:clamp(2.4rem,12vw,3.5rem); }
    .article-media { border-radius:.9rem; }
    .article-figure { width:165px; opacity:.035; }
    .article-figure--left { left:-8rem; }
    .article-figure--right { right:-8rem; }
  }
  @media(max-width:500px){
        .article-heading h1 { 
          font-size:clamp(2.4rem,12vw,2.5rem); }

    .article-figure { top:50%; width:170px; opacity:.035; }
    .article-figure--left { 
      top: -1rem;
      left: -5rem; }
    .article-figure--right { 
      top: 15rem;
      right: -5rem;}
  }
</style>
