---
import { localeFromPath, localizedUrl } from '../../i18n';
import awardsIcon from '../../assets/awards-icon.png';
const locale = localeFromPath(Astro.url.pathname);
const copy = {
  sq:{heading:'Çmimet',winner:'“Aktori më i Mirë”',cta:'SHIKO ÇMIMET',awards:['Festivali i Filmit në Gjilan','Festivali i Komedisë Shqiptare në Preshevë','Festivali Ballkanik i Teatrit në Prishtinë','Festivali i Teatrove Shqiptare në Dibër të Maqedonisë']},
  en:{heading:'Awards',winner:'“Best Actor”',cta:'VIEW AWARDS',awards:['Film Festival in Gjilan','Albanian Comedy Festival in Presheva','Balkan Theatre Festival in Pristina','Albanian Theatre Festival in Dibër, North Macedonia']},
  bs:{heading:'Nagrade',winner:'„Najbolji glumac“',cta:'POGLEDAJ NAGRADE',awards:['Filmski festival u Gnjilanu','Festival albanske komedije u Preševu','Balkanski pozorišni festival u Prištini','Festival albanskih pozorišta u Debru, Sjeverna Makedonija']},
}[locale];
---

<section class="awards-home">
  <div class="awards-home__inner">
    <h2>{copy.heading}</h2>
    <div class="awards-home__grid">
      {copy.awards.map((award) => (
        <article class="award-card reveal-near">
          <img class="award-card__icon" src={awardsIcon.src} alt="" loading="lazy" />
          <h3>{copy.winner}</h3>
          <p>{award}</p>
        </article>
      ))}
    </div>
    <a href={localizedUrl(locale, 'about')} class="btn-gold">{copy.cta}</a>
  </div>
</section>

<style>
  .awards-home { padding:clamp(5rem,7vw,7rem) var(--page-gutter) clamp(5.5rem,8vw,8rem); background:#070b10; }
  .awards-home__inner { width:min(100%,1280px); margin:auto; text-align:center; }
  .awards-home h2 { color:var(--color-gold-bright); font-size:var(--home-section-title-size); line-height:1; font-weight:400; margin-bottom:clamp(3rem,4vw,4rem); }
  .awards-home__grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(1.25rem,1.8vw,2rem); }
  .award-card { min-height:300px; padding:2.4rem 1.4rem; border:1px solid rgba(212,177,106,.9); border-radius:.65rem; box-shadow:0 0 12px rgba(212,177,106,.12),inset 0 0 10px rgba(212,177,106,.035); display:flex; flex-direction:column; justify-content:center; align-items:center; background:#0b0e13; }
  .award-card__icon { width:75px; height:82px; margin-bottom:0.8rem; object-fit:contain; }
  .award-card h3 { font:400 1.3rem/1.2 'Cormorant Garamond',serif; }
  .award-card p { max-width:230px; margin-top:.75rem; color:var(--color-gold-bright); text-transform:uppercase; font-size:.68rem; line-height:1.5; letter-spacing:.035em; }
  .awards-home .btn-gold { min-width:190px; margin-top:3rem; }
  @media(max-width:900px){.awards-home__grid{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:521px) and (max-width:900px) {
    .awards-home__grid { width:min(100%,590px); margin-inline:auto; gap:1rem; }
    .award-card { min-height:235px; padding:1.6rem 1rem; }
    .award-card__icon { width:58px; height:64px; margin-bottom:.6rem; }
    .award-card h3 { font-size:1.08rem; }
    .award-card p { max-width:190px; margin-top:.6rem; font-size:.6rem; }
  }
  @media(max-width:520px){.awards-home__grid{grid-template-columns:1fr}.award-card{min-height:220px}.awards-home h2{margin-bottom:2rem}}
  @media(max-width:635px) {
    .awards-home__grid { width:min(100%,500px); gap:.85rem; }
    .award-card { min-height:200px; padding:1.25rem .8rem; }
    .award-card__icon { width:50px; height:55px; margin-bottom:.45rem; }
    .award-card h3 { font-size:1rem; }
    .award-card p { max-width:170px; margin-top:.5rem; font-size:.56rem; }
  }
  @media(max-width:500px) {
    .awards-home__grid { width:min(100%,360px); margin-inline:auto; gap:.75rem; }
    .award-card { min-height:160px; padding:1rem .75rem; }
    .award-card__icon { width:42px; height:46px; margin-bottom:.35rem; }
    .award-card h3 { font-size:.9rem; }
    .award-card p { max-width:155px; margin-top:.4rem; font-size:.52rem; }
  }
  @media(max-width:430px) {
    .awards-home__grid { width:min(100%,275px); gap:.65rem; }
    .award-card { min-height:135px; padding:.75rem .65rem; }
    .award-card__icon { width:38px; height:40px; margin-bottom:.25rem; }
    .award-card h3 { font-size:.86rem; }
    .award-card p { max-width:150px; margin-top:.3rem; font-size:.49rem; line-height:1.4; }
  }
</style>
