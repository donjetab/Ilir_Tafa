---
// load files
const entries = await import.meta.glob("../../content/news/*.json", { eager: true, import: "default" });

type NewsPost = {
  type?: "internal" | "external";
  date?: string;
  slug: string;
  cover?: string;
  title?: string;
  excerpt?: string;
  sourceUrl?: string;
};

// normalize + add slug from filename
const posts: NewsPost[] = Object.entries(entries).map(([file, p]: [string, any]) => {
  const fileSlug = file.split("/").pop()?.replace(".json", "") ?? "";
  return {
    slug: p?.slug ?? fileSlug,
    type: p?.type,
    sourceUrl: p?.sourceUrl,
    date: p?.date ?? "",
    cover: p?.cover ?? "",
    title: p?.title ?? "",
    excerpt: p?.excerpt ?? "",
  };
});

// pick by slug
const wanted = new Set(["bretkosat-teatri-prizren", "abasadori-kulturor-i-evropes"]);
const items = posts.filter(p => wanted.has(p.slug));

// fallback if none found
const safeItems = items.length ? items : posts.slice(0, 2);
---


<section class="news w-full h-screen bg-[#0e141a] text-white flex flex-col items-center justify-center text-center gap-20">
  <h2 class="text-3xl md:text-5xl font-semibold title mt-10 reveal" style="--delay:.1s">
    LAJMET E FUNDIT
  </h2>

  <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-12 px-12 text-left">
    {safeItems.map((n, i) => (
      <a
        href={n.sourceUrl || `/lajmet/${n.slug}`}
        target={n.type === "external" ? "_blank" : "_self"}
        rel={n.type === "external" ? "noopener noreferrer" : undefined}
        class="flex items-center justify-center gap-6 w-full group reveal"
        style={`--delay:${0.15 + i * 0.1}s`}
      >
        <!-- Image -->
        <div class="w-48 h-48 lg:w-56 lg:h-56 rounded-[28px] overflow-hidden flex-shrink-0 bg-[#1c2733]">
          <img
            src={n.cover}
            alt={n.title}
            class="w-full h-full object-cover object-center"
            style="aspect-ratio:1/1;display:block;"
          />
        </div>

        <!-- Text -->
        <div class="max-w-md">
            <span class="text-xs md:text-sm text-[#d4dbe1]/50 block mb-1">
              {n.date}
            </span>
          <h3 class="text-xl md:text-2xl font-medium mb-2 group-hover:text-[#d4af37] transition-colors" style="font-size:1.3rem;font-weight:500;">
            {n.title}
          </h3>
          <p class="text-sm md:text-base leading-relaxed text-[#d4dbe1]" style="margin-top:10px;">
            {n.excerpt}
          </p>
        </div>
      </a>
    ))}
  </div>

  <a href="news" class="btn-gold reveal" style="--delay:.35s">MË SHUMË</a>
</section>


<style>
/* ───────────── Desktop & tablet ≤1024px ───────────── */
@media (max-width:1024px) {
  .news {
    padding: 5%;
  }
  .news h3 {
    font-size: 15px !important;
  }
  .news p {
    font-size: 10px;
  }
}

/* ───────────── Tablet ≤768px ───────────── */
@media (max-width:768px) {
  .news {
    gap: 40px;
  }
}

/* ───────────── Mobile ≤640px ───────────── */
@media (max-width:640px) {
  /* Section layout */
  .news {
    margin-top: 100px;
    margin-bottom: 100px;
    height: auto;
    min-height: 100vh;
    padding-block: 3rem;
    gap: 40px;
    justify-content: flex-start;
    text-align: center;
  }

  .news .grid {
    max-width: 1100px;
    margin-inline: auto;
    grid-template-columns: 1fr;
    gap: 30px;
    padding-inline: 16px;
  }

  /* Card look */
  .news a {
    background: #101923;
    border: 1px solid #243241;
    border-radius: 20px;
    padding: 16px;
    transition: transform .2s ease;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .news a:hover {
    transform: translateY(-2px);
  }

  .news a h3 {
    margin: 0;
  }

  .news a p {
    margin: 8px 0 0;
  }

  /* Image handling */
  .news a > div:first-child {
    width: 100%;
    height: 200px;
    border-radius: 18px;
    overflow: hidden;
  }

  .news a img {
    width: 100%;
    height: 180%;
    object-fit: cover;
  }

  /* Title + button */
  .news .title {
    font-size: 50px;
    margin-bottom: 0;
  }

  .btn-gold {
    padding: 0.85rem 2.5rem !important;
    border-radius: 9999px !important;
    border: 3.5px solid #d4b16a !important;
    background-color: #1c2229 !important;
    margin-top: 0;
  }
}

/* ───────────── Larger screens ≥641px ───────────── */
@media (min-width:641px) {
  .news a > div:first-child {
    width: 224px;
    height: 224px; /* roughly w-56 h-56 */
  }
}
</style>
