---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/backup.png';
import logo from '../assets/logo nobg.png';
import { SITE_TITLE } from '../consts';
import { localeFromPath, locales, localizedUrl, stripLocale, type Locale } from '../i18n';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	locale?: Locale;
	datePublished?: string;
	author?: string;
}

const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site);
const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	locale = localeFromPath(Astro.url.pathname),
	datePublished,
	author = 'Ilir Tafa',
} = Astro.props;
const socialImage = typeof image === 'string'
	? new URL(image, siteRoot)
	: new URL(image.src, Astro.site);
const languagePath = stripLocale(Astro.url.pathname);
const preferredPath = localizedUrl(locale, languagePath);
const canonicalURL = new URL(preferredPath, Astro.site);
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isLegacyRoute = currentPath !== preferredPath.replace(/\/$/, '');
const htmlLocale = { sq: 'sq_AL', en: 'en_US', bs: 'bs_BA' }[locale];
const verification = import.meta.env.GOOGLE_SITE_VERIFICATION;
const isHome = languagePath === '';
const personId = new URL('#person', siteRoot).href;
const websiteId = new URL('#website', siteRoot).href;
const breadcrumbNames: Record<string, string> = {
	biografia: 'Biografia', biography: 'Biography', biografija: 'Biografija',
	veprat: 'Veprat', works: 'Works', djela: 'Djela',
	lajme: 'Lajme', news: 'News', vijesti: 'Vijesti',
	galeria: 'Galeria', gallery: 'Gallery', galerija: 'Galerija',
};
const pathParts = preferredPath.replace(import.meta.env.BASE_URL, '').split('/').filter(Boolean);
const breadcrumbItems = pathParts.map((part, index) => ({
	'@type': 'ListItem',
	position: index + 2,
	name: breadcrumbNames[part] ?? decodeURIComponent(part).replace(/-/g, ' '),
	item: new URL(`${pathParts.slice(0, index + 1).join('/')}/`, siteRoot).href,
}));
const graph: Record<string, unknown>[] = [];
if (isHome) {
	graph.push(
		{
			'@type': 'WebSite', '@id': websiteId, url: siteRoot.href,
			name: SITE_TITLE, description, inLanguage: locale,
		},
		{
			'@type': 'Person', '@id': personId, name: 'Ilir Tafa',
			url: siteRoot.href, image: socialImage.href,
			jobTitle: 'Actor', nationality: 'Kosovo',
			sameAs: [
				'https://sq.wikipedia.org/wiki/Ilir_Tafa',
				'https://en.wikipedia.org/wiki/Ilir_Tafa',
				'https://bs.wikipedia.org/wiki/Ilir_Tafa',
			],
		},
		{
			'@type': 'ProfilePage', '@id': canonicalURL.href,
			url: canonicalURL.href, name: title, description,
			mainEntity: { '@id': personId }, inLanguage: locale,
		},
	);
}
if (breadcrumbItems.length > 0) {
	graph.push({
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: SITE_TITLE, item: siteRoot.href },
			...breadcrumbItems,
		],
	});
}
if (type === 'article') {
	graph.push({
		'@type': 'Article', '@id': `${canonicalURL.href}#article`,
		headline: title, description, image: socialImage.href,
		url: canonicalURL.href, inLanguage: locale,
		...(datePublished ? { datePublished } : {}),
		author: author === 'Ilir Tafa' ? { '@id': personId } : { '@type': 'Person', name: author },
		publisher: { '@id': personId },
	});
}
const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<!-- Global Metadata -->

<base href={import.meta.env.BASE_URL} />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href={logo.src} />
<link rel="sitemap" href={new URL('sitemap-index.xml', siteRoot)} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', siteRoot)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{isLegacyRoute && <meta http-equiv="refresh" content={`0;url=${preferredPath}`} />}
{isLegacyRoute && <meta name="robots" content="noindex,follow" />}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- playfair -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"rel="stylesheet"/>
<!-- poppins -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
<!-- lato -->
<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
<!-- garamond -->
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{verification && <meta name="google-site-verification" content={verification} />}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:locale" content={htmlLocale} />
{locales.filter((language) => language !== locale).map((language) => (
  <meta property="og:locale:alternate" content={{ sq: 'sq_AL', en: 'en_US', bs: 'bs_BA' }[language]} />
))}
<meta property="og:site_name" content={SITE_TITLE} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
{locales.map((language) => (
  <link rel="alternate" hreflang={language} href={new URL(localizedUrl(language, languagePath), Astro.site)} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localizedUrl('sq', languagePath), Astro.site)} />
{graph.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
