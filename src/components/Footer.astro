---
import logo from '../assets/full logo.png';
import { localeFromPath, localizedUrl, useTranslations } from '../i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const year = new Date().getFullYear();

const nav = [
  ['', t.home],
  ['about', t.about],
  ['works', t.activity],
  ['news', t.news],
  ['gallery', t.gallery],
];

const intro = {
  sq: 'Ilir Tafa është aktor i teatrit dhe filmit nga Kosova. Me një karrierë të pasur artistike, ai ka interpretuar në dhjetëra role që kanë prekur publikun dhe kritikën njëlloj.',
  en: 'Ilir Tafa is a theatre and film actor from Kosovo. With a rich artistic career, he has performed dozens of roles that have touched audiences and critics alike.',
  bs: 'Ilir Tafa je pozorišni i filmski glumac sa Kosova. Tokom bogate umjetničke karijere ostvario je desetine uloga koje su podjednako dirnule publiku i kritiku.',
}[locale];

const wikipediaUrl = {
  sq: 'https://sq.wikipedia.org/wiki/Ilir_Tafa',
  en: 'https://en.wikipedia.org/wiki/Ilir_Tafa',
  bs: 'https://bs.wikipedia.org/wiki/Ilir_Tafa',
}[locale];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <a href={localizedUrl(locale)} class="site-footer__brand">
      <img src={logo.src} alt="Ilir Tafa" />
    </a>

    <div class="site-footer__intro">
      <h2>{locale === 'sq' ? 'RRETH AKTORIT ILIR TAFA' : locale === 'en' ? 'ABOUT ACTOR ILIR TAFA' : 'O GLUMCU ILIRU TAFI'}</h2>
      <p>{intro}</p>
    </div>

    <nav aria-label={t.navigation}>
      <h2>{locale === 'sq' ? 'NAVIGIMI' : locale === 'en' ? 'NAVIGATION' : 'NAVIGACIJA'}</h2>
      {nav.map(([href, label]) => <a href={localizedUrl(locale, href)}>{label}</a>)}
    </nav>

    <div class="site-footer__social">
      <h2>{locale === 'sq' ? 'NDIQENI' : locale === 'en' ? 'FOLLOW' : 'PRATITE'}</h2>
      <div>
        <a href="https://www.instagram.com/ilirtafa/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle class="social-fill" cx="17.4" cy="6.7" r="1.1"/></svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=100050606764195" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="social-fill" d="M14.2 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H8V13h2.8v8z"/></svg>
        </a>
        <a href={wikipediaUrl} target="_blank" rel="noopener noreferrer" aria-label="Wikipedia">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path class="social-fill" d="M2.2 5h6v1.2H7.1l3.6 9.4 2.5-6.1-1.3-3.3h-1.4V5h5v1.2H14l3.5 9.2 3.3-9.2h-1.7V5h4.7v1.2h-1.4L17 20h-1.2l-3.2-8-3.4 8H8L2.9 6.2h-.7z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <p class="site-footer__legal">© {year} Ilir Tafa. Administruar nga D.B.</p>
</footer>

<style is:global>
  .site-footer {
    padding: 4.5rem var(--page-gutter) 1.75rem;
    background: #090b0e;
    border-top: 1px solid rgba(198, 166, 100, .55);
    color: rgba(255, 255, 255, .78);
  }

  .site-footer__inner {
    width: min(100%, 1400px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr 1.75fr .65fr .75fr;
    gap: clamp(4rem, 7vw, 8rem);
    align-items: start;
  }

  .site-footer__brand img {
    width: clamp(150px, 11vw, 180px);
    height: auto;
  }

  .site-footer h2 {
    margin: 0 0 1rem;
    color: var(--color-gold-bright);
    font: 600 .82rem/1.4 Poppins, sans-serif;
    letter-spacing: .04em;
  }

  .site-footer p,
  .site-footer a {
    font-size: .82rem;
    line-height: 1.75;
  }

  .site-footer__intro p {
    max-width: 440px;
    margin: 0;
  }

  .site-footer nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .site-footer__social > div {
    display: flex;
    gap: 1rem;
  }

  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .17);
    color: #fff;
    transition: transform .2s ease, background .2s ease, color .2s ease;
  }

  .site-footer__social a:hover {
    transform: translateY(-3px);
    background: var(--color-gold-bright);
    color: #090b0e;
  }

  .site-footer__social svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .site-footer__social .social-fill {
    fill: currentColor;
    stroke: none;
  }

  .site-footer__legal {
    margin: 3.25rem 0 0;
    text-align: center;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1.5fr 1fr;
      gap: 3rem;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 521px) and (max-width: 900px) {
    .site-footer {
      padding: 3rem 2rem 1.25rem;
    }

    .site-footer__inner {
      grid-template-columns: .75fr 1.4fr .65fr 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    .site-footer__brand {
      grid-column: auto;
    }

    .site-footer__brand img {
      width: 110px;
    }

    .site-footer h2 {
      margin-bottom: .7rem;
      font-size: .7rem;
    }

    .site-footer p,
    .site-footer a {
      font-size: .72rem;
      line-height: 1.6;
    }

    .site-footer__social > div {
      gap: .65rem;
    }

    .site-footer__social a {
      width: 36px;
      height: 36px;
    }

    .site-footer__social svg {
      width: 18px;
      height: 18px;
    }

    .site-footer__legal {
      margin-top: 2rem;
    }
  }

  @media (max-width: 620px) {
    .site-footer {
      padding-top: 3.5rem;
    }

    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .site-footer__brand {
      grid-column: auto;
    }

    .site-footer__brand img {
      margin-inline: auto;
    }

    .site-footer__intro p {
      margin-inline: auto;
    }

    .site-footer nav {
      align-items: center;
    }

    .site-footer__social > div {
      justify-content: center;
    }
  }
</style>
