---
interface Item {
  icon?: ImageMetadata | string;
  img?: ImageMetadata | string;
  title: string;
  paragraphs: string[];
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const src = (image?: ImageMetadata | string) => {
  if (!image) return "";
  return typeof image === "string" ? image : image.src;
};
---

<section class="about-timeline" aria-label="Biografia e Ilir Tafës">
  <div class="about-timeline__inner">
    <div class="about-timeline__line" aria-hidden="true"></div>
    <div class="about-timeline__progress" aria-hidden="true"></div>
    <span class="about-timeline__traveler" aria-hidden="true"></span>

    {items.map((item, index) => (
      <article class="about-timeline__item" data-timeline-item data-index={index}>
        <span class="about-timeline__dot" aria-hidden="true"></span>
        <div class="about-timeline__icon">
          {(item.icon || item.img) && (
            <img src={src(item.icon || item.img)} alt="" loading="lazy" />
          )}
        </div>
        <div class="about-timeline__content">
          <h2>{item.title}</h2>
          {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const setupTimeline = () => {
    document.querySelectorAll<HTMLElement>('.about-timeline__inner').forEach((timeline) => {
      if (timeline.dataset.ready === 'true') return;
      timeline.dataset.ready = 'true';
      timeline.classList.add('is-ready');

      const items = [...timeline.querySelectorAll<HTMLElement>('[data-timeline-item]')];
      const progress = timeline.querySelector<HTMLElement>('.about-timeline__progress');
      const traveler = timeline.querySelector<HTMLElement>('.about-timeline__traveler');
      let frame = 0;

      const update = () => {
        frame = 0;
        const rect = timeline.getBoundingClientRect();
        const start = window.innerHeight * 0.62;
        const end = window.innerHeight * 0.38;
        const distance = Math.max(1, rect.height - start + end);
        const traveled = Math.min(distance, Math.max(0, start - rect.top));
        const ratio = traveled / distance;
        const markerY = ratio * rect.height;

        timeline.style.setProperty('--timeline-progress', `${ratio * 100}%`);
        progress?.style.setProperty('height', `${ratio * 100}%`);
        traveler?.style.setProperty('top', `${markerY}px`);

        items.forEach((item) => {
          const trigger = item.offsetTop - Math.min(90, window.innerHeight * 0.08);
          item.classList.toggle('is-active', markerY >= trigger);
        });
      };

      const requestUpdate = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };

      update();
      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);
    });
  };

  setupTimeline();
  document.addEventListener('astro:page-load', setupTimeline);
</script>

<style>
  .about-timeline {
    padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 6vw, 6rem) clamp(5rem, 10vw, 9rem);
  }

  .about-timeline__inner {
    --line-x: 1rem;
    position: relative;
    width: min(100%, 78rem);
    margin-inline: auto;
  }

  .about-timeline__line {
    position: absolute;
    top: 1.1rem;
    bottom: 1.1rem;
    left: var(--line-x);
    width: 2px;
    background: rgba(216, 174, 91, 0.2);
  }

  .about-timeline__progress {
    position: absolute;
    z-index: 1;
    top: 1.1rem;
    left: var(--line-x);
    width: 2px;
    height: 0;
    max-height: calc(100% - 2.2rem);
    background: linear-gradient(to bottom, #f2ce7b, #d8ae5b);
    box-shadow: 0 0 0.7rem rgba(216, 174, 91, 0.42);
    transition: height 80ms linear;
  }

  .about-timeline__traveler {
    position: absolute;
    z-index: 4;
    top: 0;
    left: var(--line-x);
    width: 1.15rem;
    aspect-ratio: 1;
    border: 2px solid #f8d989;
    border-radius: 50%;
    background: #d8ae5b;
    box-shadow: 0 0 0.6rem rgba(216, 174, 91, 0.8), 0 0 1.4rem rgba(216, 174, 91, 0.45);
    transform: translate(-50%, -50%);
    transition: top 80ms linear;
  }

  .about-timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: clamp(2.5rem, 6vw, 6.5rem);
    min-height: 18rem;
    padding-left: clamp(4.5rem, 8vw, 8rem);
  }

  .about-timeline__item + .about-timeline__item {
    margin-top: clamp(2rem, 5vw, 5rem);
  }

  .about-timeline__dot {
    position: absolute;
    top: 0.15rem;
    left: var(--line-x);
    width: 1.35rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid rgba(216, 174, 91, 0.48);
    background: #090e14;
    box-shadow: none;
    transform: translateX(calc(-50% + 1px));
    transition: background-color 420ms ease, border-color 420ms ease, box-shadow 420ms ease, transform 420ms ease;
  }

  .about-timeline__icon {
    display: grid;
    place-items: start center;
    padding-top: 3.5rem;
  }

  .about-timeline__icon img {
    width: 5.25rem;
    height: 5.25rem;
    object-fit: contain;
    transition: opacity 650ms ease, transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 650ms ease;
  }

  .about-timeline__content h2 {
    margin: 0 0 1.35rem;
    color: #d8ae5b;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.25rem, 1.8vw, 1.65rem);
    font-weight: 500;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .about-timeline__content p {
    max-width: 61rem;
    margin: 0;
    color: rgba(245, 245, 245, 0.84);
    font-size: clamp(0.92rem, 1vw, 1.04rem);
    line-height: 1.52;
  }

  .about-timeline__content p + p {
    margin-top: 0.8rem;
  }

  .is-ready .about-timeline__content,
  .is-ready .about-timeline__icon img {
    opacity: 0;
    transform: translateY(2.25rem);
  }

  .about-timeline__content {
    transition: opacity 650ms ease, transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .about-timeline__item.is-active .about-timeline__content,
  .about-timeline__item.is-active .about-timeline__icon img {
    opacity: 1;
    transform: translateY(0);
  }

  .about-timeline__item.is-active .about-timeline__icon img {
    filter: drop-shadow(0 0 0.65rem rgba(216, 174, 91, 0.18));
  }

  .about-timeline__item.is-active .about-timeline__dot {
    border-color: #f2ce7b;
    background: #d8ae5b;
    box-shadow: 0 0 0.75rem rgba(216, 174, 91, 0.65);
    transform: translateX(calc(-50% + 1px)) scale(1.08);
  }

  @media (max-width: 720px) {
    .about-timeline__inner {
      --line-x: 0.65rem;
    }

    .about-timeline__item {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-left: 3.25rem;
    }

    .about-timeline__item + .about-timeline__item {
      margin-top: 4.5rem;
    }

    .about-timeline__icon {
      place-items: start;
      padding: 0 0 1.5rem;
    }

    .about-timeline__icon img {
      width: 4rem;
      height: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-timeline__traveler,
    .about-timeline__progress {
      display: none;
    }

    .is-ready .about-timeline__content,
    .is-ready .about-timeline__icon img {
      opacity: 1;
      transform: none;
    }
  }
</style>
