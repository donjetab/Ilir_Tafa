---
interface Props {
  hero: ImageMetadata | string;
  name: string;
  tagline?: string;
  intro: string;
}

const {
  hero,
  name,
  tagline = "një nga aktorët më të njohur në Ballkan",
  intro,
} = Astro.props;
---

<section class="about-header" aria-labelledby="about-title">
  <div class="about-hero__inner">
    <div class="about-hero__visual">
      <img
        src={typeof hero === "string" ? hero : hero.src}
        alt={name}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="about-hero__copy">
      <h1 id="about-title">{name}</h1>
      <p class="about-hero__tagline">{tagline}</p>
      <p class="about-hero__intro">{intro}</p>
    </div>
  </div>
</section>

<style>
  .about-header {
    position: relative;
    min-height: clamp(37rem, 68svh, 46rem);
    overflow: hidden;
  }

  .about-hero__inner {
    width: 100%;
    min-height: inherit;
    padding: clamp(7.5rem, 10vw, 9.5rem) clamp(2rem, 7vw, 8rem) clamp(3.5rem, 7vw, 5.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 5rem);
  }

  .about-hero__visual {
    position: absolute;
    inset: 0 auto auto -3%;
    width: 60%;
    height: clamp(29rem, 42vw, 39rem);
    isolation: isolate;
  }

  .about-hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 46%;
    border-radius: 0;
    filter: saturate(0.7) brightness(0.64) contrast(1.04);
  }

  .about-hero__visual::after {
    content: "";
    position: absolute;
    inset: -1px;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(to right,#070b10 0%,rgba(7,11,16,0.32) 7%,transparent 16%),
      linear-gradient(to bottom,#070b10 0%,rgba(7,11,16,0.3) 7%,transparent 16%),
      linear-gradient(to left,#070b10 0%,rgba(7,11,16,0.99) 7%,rgba(7,11,16,0.84) 12%,rgba(7,11,16,0.4) 30%,transparent 57%),
      linear-gradient(to top,#070b10 0%,rgba(7,11,16,0.99) 8%,rgba(7,11,16,0.82) 22%,rgba(7,11,16,0.38) 39%,transparent 57%)
      /* linear-gradient(to right, #070b10 0%, rgba(7, 11, 16, 0.32) 7%, transparent 16%),
      linear-gradient(to bottom, #070b10 0%, rgba(7, 11, 16, 0.3) 7%, transparent 16%),
      linear-gradient(to left, #070b10 0%, rgba(7, 11, 16, 0.99) 8%, rgba(7, 11, 16, 0.84) 22%, rgba(7, 11, 16, 0.4) 39%, transparent 57%),
      linear-gradient(to top, #070b10 0%, rgba(7, 11, 16, 0.99) 8%, rgba(7, 11, 16, 0.82) 22%, rgba(7, 11, 16, 0.38) 39%, transparent 57%); */
  }

  .about-hero__copy {
    position: relative;
    z-index: 2;
    grid-column: 2;
    max-width: 50rem;
    margin-top: 1.5rem;
  }

  h1 {
    margin: 0;
    color: #d8ae5b;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(3.5rem, 4.8vw, 5.25rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .about-hero__tagline {
    margin: 0.65rem 0 0;
    color: #c99d4d;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    font-style: italic;
    line-height: 1.25;
  }

  .about-hero__intro {
    margin: 0.75rem 0 0;
    color: rgba(244, 244, 244, 0.82);
    font-size: clamp(0.92rem, 1vw, 1.05rem);
    line-height: 1.48;
  }

  @media (max-width: 800px) {
    .about-header {
      min-height: auto;
    }

    .about-hero__inner {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 5.5rem 1.25rem 3.5rem;
    }

    .about-hero__visual {
      position: relative;
      inset: auto;
      width: calc(100% + 2.5rem);
      height: min(75vw, 27rem);
      margin-inline: -1.25rem;
    }

    .about-hero__copy {
      grid-column: 1;
      max-width: 38rem;
      margin-inline: auto;
      text-align: center;
    }
  }

  @media(max-width: 800px) {
    .about-hero__visual::after {
      background:
        linear-gradient(to right,#070b10 0%,rgba(7,11,16,.55) 7%,transparent 18%),
        linear-gradient(to left,#070b10 0%,rgba(7,11,16,.55) 7%,transparent 18%),
        linear-gradient(to bottom,#070b10 0%,rgba(7,11,16,.3) 7%,transparent 16%),
        linear-gradient(to top,#070b10 0%,rgba(7,11,16,.99) 8%,rgba(7,11,16,.82) 22%,rgba(7,11,16,.38) 39%,transparent 57%);
    }
  }

  @media (max-width: 480px) {
    .about-header {
      padding: 0;
    }

    .about-hero__visual {
      height: 20rem;
      width: calc(100% + 2.5rem);
      margin-inline: -1.25rem;
    }

    .about-hero__copy {
      padding-inline: 0.75rem;
    }

    h1 {
      font-size: clamp(3rem, 17vw, 4.3rem);
    }

    .about-hero__intro {
      text-align: left;
    }
    
  @media(max-width: 430px) {
    .about-hero__visual::after {
      background:
        linear-gradient(to right,#070b10 5%,rgba(7,11,16,.55) 12%,transparent 18%),
        linear-gradient(to left,#070b10 0%,rgba(7,11,16,.55) 7%,transparent 18%),
        linear-gradient(to bottom,#070b10 0%,rgba(7,11,16,.3) 7%,transparent 16%),
        linear-gradient(to top,#070b10 0%,rgba(7,11,16,.99) 8%,rgba(7,11,16,.82) 22%,rgba(7,11,16,.38) 39%,transparent 57%)

    }
  }
  }
</style>
